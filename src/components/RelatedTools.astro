---
/**
 * RelatedTools — shows 2-3 related tool cards at the bottom of tool pages.
 * Takes an array of tool objects and renders them in a responsive grid.
 */
interface Tool {
  title: string;
  description: string;
  href: string;
}

interface Props {
  tools: Tool[];
}

const { tools } = Astro.props;
---

<section class="mt-16 pt-12 border-t border-hairline">
  <h2 class="text-display-md text-ink mb-6">Related tools.</h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {tools.map((tool) => (
      <a href={tool.href} class="card-marketing group block no-underline">
        <div class="flex flex-col gap-2">
          <h3 class="text-body-md-strong text-ink m-0 group-hover:text-link transition-colors">{tool.title}</h3>
          <p class="text-body-sm text-body m-0">{tool.description}</p>
          <div class="flex items-center gap-1 text-body-sm text-link mt-1 group-hover:gap-2 transition-all duration-200">
            <span>Try now</span>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M3 7H11M11 7L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
