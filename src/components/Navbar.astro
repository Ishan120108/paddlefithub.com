---
const currentPath = Astro.url.pathname;

const tools = [
  { label: 'Grip Size Calculator', href: '/tools/grip-size-calculator/' },
  { label: 'Paddle Weight Advisor', href: '/tools/paddle-weight-advisor/' },
  { label: 'Paddle Shape Fit', href: '/tools/paddle-shape-fit/' },
  { label: 'Core Thickness Advisor', href: '/tools/core-thickness-advisor/' },
  { label: 'Overgrip Weight Adjustment', href: '/tools/overgrip-weight-adjustment/' },
  { label: 'Arm-Friendly Finder', href: '/tools/arm-friendly-paddle-finder/' },
  { label: 'Round-Robin Generator', href: '/tools/round-robin-generator/' },
];

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];
---

<header class="sticky top-0 z-50 bg-canvas border-b border-hairline" id="site-navbar">
  <nav class="container-page flex items-center justify-between h-16" aria-label="Main navigation">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 no-underline group" aria-label="PaddleFitHub Home">
      <span class="flex items-center justify-center w-8 h-8 bg-ink rounded-sm">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="12" cy="9" r="6" stroke="white" stroke-width="2" fill="none"/>
          <line x1="12" y1="15" x2="12" y2="23" stroke="white" stroke-width="2" stroke-linecap="round"/>
          <circle cx="12" cy="9" r="2" fill="white"/>
        </svg>
      </span>
      <span class="text-body-sm-strong text-ink">PaddleFitHub</span>
    </a>

    <!-- Desktop Nav Links -->
    <div class="hidden md:flex items-center gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'text-body-sm px-3 py-1.5 rounded-full transition-colors no-underline',
            currentPath === link.href
              ? 'text-ink bg-canvas-soft-2'
              : 'text-body hover:text-ink hover:bg-canvas-soft',
          ]}
        >
          {link.label}
        </a>
      ))}

      <!-- Tools Dropdown -->
      <div class="relative" id="tools-dropdown">
        <button
          type="button"
          class="text-body-sm text-body hover:text-ink px-3 py-1.5 rounded-full transition-colors flex items-center gap-1"
          id="tools-dropdown-btn"
          aria-expanded="false"
          aria-haspopup="true"
        >
          Tools
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" class="transition-transform duration-200" id="tools-dropdown-chevron">
            <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div
          class="absolute top-full left-0 mt-2 w-64 bg-canvas rounded-md py-2 opacity-0 invisible transition-all duration-200 transform -translate-y-1"
          style={`box-shadow: var(--shadow-level-5);`}
          id="tools-dropdown-menu"
          role="menu"
        >
          {tools.map((tool) => (
            <a
              href={tool.href}
              class:list={[
                'block px-4 py-2 text-body-sm no-underline transition-colors',
                currentPath === tool.href
                  ? 'text-ink bg-canvas-soft-2'
                  : 'text-body hover:text-ink hover:bg-canvas-soft',
              ]}
              role="menuitem"
            >
              {tool.label}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Desktop CTA + Dark Mode -->
    <div class="hidden md:flex items-center gap-2">
      <button
        type="button"
        id="theme-toggle-desktop"
        class="w-9 h-9 rounded-full border border-hairline bg-canvas text-mute hover:text-ink hover:border-hairline-strong flex items-center justify-center cursor-pointer transition-colors"
        aria-label="Toggle dark mode"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="sun-icon hidden" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
        </svg>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="moon-icon" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
      <a href="/tools/grip-size-calculator/" class="btn-primary-sm">
        Get Started
      </a>
    </div>

    <!-- Mobile Hamburger + Dark Mode -->
    <div class="md:hidden flex items-center gap-2">
      <button
        type="button"
        id="theme-toggle-mobile"
        class="w-9 h-9 rounded-full border border-hairline bg-canvas text-mute hover:text-ink flex items-center justify-center cursor-pointer transition-colors"
        aria-label="Toggle dark mode"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="sun-icon hidden" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
        </svg>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="moon-icon" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
      <button
        type="button"
        class="flex items-center justify-center w-10 h-10 rounded-sm border border-hairline bg-canvas text-ink"
        id="mobile-menu-btn"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" id="hamburger-icon">
          <path d="M3 5H17M3 10H17M3 15H17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" class="hidden" id="close-icon">
          <path d="M5 5L15 15M15 5L5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu Overlay -->
  <div
    class="md:hidden fixed inset-0 top-16 bg-canvas z-40 overflow-y-auto hidden"
    id="mobile-menu"
  >
    <div class="p-4 flex flex-col gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'text-body-sm px-4 py-3 rounded-md no-underline transition-colors',
            currentPath === link.href
              ? 'text-ink bg-canvas-soft-2'
              : 'text-body hover:text-ink hover:bg-canvas-soft',
          ]}
        >
          {link.label}
        </a>
      ))}
      <div class="border-t border-hairline my-2"></div>
      <p class="px-4 pt-2 text-caption-mono text-mute uppercase tracking-wide">Tools</p>
      {tools.map((tool) => (
        <a
          href={tool.href}
          class:list={[
            'text-body-sm px-4 py-3 rounded-md no-underline transition-colors',
            currentPath === tool.href
              ? 'text-ink bg-canvas-soft-2'
              : 'text-body hover:text-ink hover:bg-canvas-soft',
          ]}
        >
          {tool.label}
        </a>
      ))}
      <div class="border-t border-hairline my-2"></div>
      <a href="/tools/grip-size-calculator/" class="btn-primary-sm text-center mx-4 mt-2">
        Get Started
      </a>
    </div>
  </div>
</header>

<script>
  // Dark mode toggle
  function setTheme(dark) {
    const html = document.documentElement;
    if (dark) {
      html.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    } else {
      html.classList.remove('dark');
      localStorage.setItem('theme', 'light');
    }
    updateIcons(dark);
  }

  function updateIcons(dark) {
    document.querySelectorAll('.sun-icon').forEach(el => el.classList.toggle('hidden', !dark));
    document.querySelectorAll('.moon-icon').forEach(el => el.classList.toggle('hidden', dark));
  }

  const stored = localStorage.getItem('theme');
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  const isDark = stored === 'dark' || (!stored && prefersDark);
  if (isDark) document.documentElement.classList.add('dark');
  updateIcons(isDark);

  document.getElementById('theme-toggle-desktop')?.addEventListener('click', () => {
    setTheme(!document.documentElement.classList.contains('dark'));
  });
  document.getElementById('theme-toggle-mobile')?.addEventListener('click', () => {
    setTheme(!document.documentElement.classList.contains('dark'));
  });

  // Tools dropdown toggle
  const dropdownBtn = document.getElementById('tools-dropdown-btn');
  const dropdownMenu = document.getElementById('tools-dropdown-menu');
  const dropdownChevron = document.getElementById('tools-dropdown-chevron');

  if (dropdownBtn && dropdownMenu && dropdownChevron) {
    dropdownBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = dropdownBtn.getAttribute('aria-expanded') === 'true';
      dropdownBtn.setAttribute('aria-expanded', String(!isOpen));
      dropdownMenu.classList.toggle('opacity-0', isOpen);
      dropdownMenu.classList.toggle('invisible', isOpen);
      dropdownMenu.classList.toggle('opacity-100', !isOpen);
      dropdownMenu.classList.toggle('visible', !isOpen);
      dropdownMenu.classList.toggle('-translate-y-1', isOpen);
      dropdownMenu.classList.toggle('translate-y-0', !isOpen);
      dropdownChevron.style.transform = isOpen ? '' : 'rotate(180deg)';
    });

    document.addEventListener('click', () => {
      dropdownBtn.setAttribute('aria-expanded', 'false');
      dropdownMenu.classList.add('opacity-0', 'invisible', '-translate-y-1');
      dropdownMenu.classList.remove('opacity-100', 'visible', 'translate-y-0');
      dropdownChevron.style.transform = '';
    });
  }

  // Mobile menu toggle
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (mobileBtn && mobileMenu && hamburgerIcon && closeIcon) {
    mobileBtn.addEventListener('click', () => {
      const isOpen = mobileBtn.getAttribute('aria-expanded') === 'true';
      mobileBtn.setAttribute('aria-expanded', String(!isOpen));
      mobileMenu.classList.toggle('hidden', isOpen);
      hamburgerIcon.classList.toggle('hidden', !isOpen);
      closeIcon.classList.toggle('hidden', isOpen);
      document.body.style.overflow = isOpen ? '' : 'hidden';
    });
  }
</script>