---
interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  faqs: FAQ[];
}

const { title = 'Frequently Asked Questions', faqs } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<section class="mt-12 pt-8 border-t border-hairline" id="faq-section">
  <div class="max-w-3xl">
    <h2 class="text-display-md text-ink mb-6">{title}</h2>

    <div class="space-y-3">
      {faqs.map((faq, index) => (
        <details class="group bg-canvas border border-hairline rounded-lg transition-colors hover:border-hairline-strong overflow-hidden">
          <summary class="flex items-center justify-between p-4 cursor-pointer text-body-sm-strong text-ink select-none font-semibold list-none [&::-webkit-details-marker]:hidden">
            <span>{faq.question}</span>
            <svg
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="ml-3 shrink-0 text-mute group-open:rotate-180 transition-transform duration-200"
            >
              <path d="M4 6l4 4 4-4" />
            </svg>
          </summary>
          <div class="px-4 pb-4 text-body-sm text-body leading-relaxed border-t border-hairline/40 pt-3">
            <p class="m-0">{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- JSON-LD FAQ Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
