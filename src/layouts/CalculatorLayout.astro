---
import Layout from './Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedTools from '../components/RelatedTools.astro';

interface RelatedTool {
  title: string;
  description: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  heading: string;
  intro: string;
  canonicalPath: string;
  relatedTools: RelatedTool[];
  disclaimer?: string;
}

const { title, description, heading, intro, canonicalPath, relatedTools, disclaimer } = Astro.props;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/#tools' },
  { label: heading },
];
---

<Layout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  author="Ishan Sahu"
  publishedTime="2026-07-29T00:00:00Z"
  modifiedTime="2026-07-30T00:00:00Z"
>
  <div class="bg-canvas-soft">
    <div class="container-page py-8 md:py-16">
      <Breadcrumbs items={breadcrumbs} />

      <!-- Page Header -->
      <div class="max-w-3xl mb-8 md:mb-10">
        <h1 class="text-display-xl text-ink mb-3">{heading}</h1>

        <div class="byline author vcard flex flex-wrap items-center gap-2 md:gap-3 text-caption text-body mb-4 pb-3 border-b border-hairline">
          <span>By <a href="/about#author" rel="author" class="fn url text-link font-medium hover:underline" itemprop="author">Ishan Sahu</a></span>
          <span class="text-mute">•</span>
          <span class="font-medium text-ink">Equipment Research &amp; Fitting Specialist (1+ Year Equipment Research)</span>
          <span class="text-mute">•</span>
          <span>Published: <time datetime="2026-07-29" itemprop="datePublished">July 29, 2026</time></span>
          <span class="text-mute">•</span>
          <span>Last updated: <time datetime="2026-07-30" itemprop="dateModified">July 30, 2026</time></span>
          <span class="text-mute">•</span>
          <span>Based on USA Pickleball specs &amp; manufacturer data — see our <a href="/about#methodology" class="text-link font-medium hover:underline">methodology</a></span>
        </div>

        <p class="text-body-lg text-body m-0" set:html={intro}></p>
      </div>

      <!-- Calculator Content (slotted) -->
      <div class="bg-canvas rounded-lg p-4 md:p-8" style={`box-shadow: var(--shadow-level-4);`}>
        <slot />
      </div>

      <!-- Assumptions / Disclaimer -->
      {disclaimer ? (
        <div class="mt-8 p-4 bg-canvas-soft-2 rounded-md">
          <p class="text-caption text-mute m-0">{disclaimer}</p>
        </div>
      ) : null}

      <!-- Related Tools -->
      <RelatedTools tools={relatedTools} />
    </div>
  </div>
</Layout>