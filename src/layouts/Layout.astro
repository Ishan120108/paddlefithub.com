---
/**
 * Base layout for all pages on paddlefithub.com.
 * Provides SEO head, font loading, analytics placeholders, and global styles.
 */
interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  author?: string;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  canonicalPath = '',
  ogImage = '/og-default.png',
  author = 'Ishan Sahu',
  publishedTime,
  modifiedTime,
} = Astro.props;

const siteUrl = 'https://paddlefithub.com';
const canonicalUrl = `${siteUrl}${canonicalPath}`;
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Critical Self-Hosted Font Preloads (Highest Priority Network Discovery) -->
    <link rel="preload" href="/fonts/geist-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-600.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Inlined Font-Face Declarations to Eliminate Render Delay -->
    <style is:inline>
      @font-face {
        font-family: 'Geist';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/geist-400.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Geist';
        font-style: normal;
        font-weight: 500;
        font-display: swap;
        src: url('/fonts/geist-500.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Geist';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/geist-600.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Geist Mono';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/geist-mono-400.woff2') format('woff2');
      }
    </style>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="paddlehub" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="author" href={`${siteUrl}/about#author`} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />
    {publishedTime ? <meta property="article:published_time" content={publishedTime} /> : null}
    {modifiedTime ? <meta property="article:modified_time" content={modifiedTime} /> : null}
    {publishedTime ? <meta property="article:author" content={`${siteUrl}/about#author`} /> : null}

    <!-- Open Graph -->
    <meta property="og:type" content={publishedTime ? "article" : "website"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="PaddleFitHub" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- Global JSON-LD Person & Organization Schema for E-E-A-T Validation -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Person",
            "@id": "https://paddlefithub.com/about#author",
            "name": "Ishan Sahu",
            "jobTitle": "Pickleball Equipment Researcher & Founder",
            "url": "https://paddlefithub.com/about#author",
            "worksFor": {
              "@type": "Organization",
              "name": "PaddleFitHub",
              "url": "https://paddlefithub.com"
            },
            "knowsAbout": ["Pickleball Equipment", "Paddle Biomechanics", "Racquet Fitting"]
          },
          {
            "@type": "Organization",
            "@id": "https://paddlefithub.com/#organization",
            "name": "PaddleFitHub",
            "url": "https://paddlefithub.com",
            "logo": {
              "@type": "ImageObject",
              "url": "https://paddlefithub.com/favicon-96x96.png"
            },
            "description": "PaddleFitHub provides data-driven pickleball equipment spec calculators, fitting tools, and research guides."
          }
        ]
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XDVPM4VDW0"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-XDVPM4VDW0');
    </script>

    <!-- WebMCP: Expose site tools to browser AI agents -->
    <script is:inline>
      if (typeof window !== 'undefined' && 'modelContext' in navigator) {
        try {
          navigator.modelContext.provideContext({
            tools: [
              {
                name: 'calculateGripSize',
                description: 'Calculates recommended pickleball paddle grip size based on palm-to-finger measurement in inches or cm.',
                inputSchema: {
                  type: 'object',
                  properties: {
                    handMeasurement: { type: 'number', description: 'Palm crease to ring finger tip' },
                    unit: { type: 'string', enum: ['inches', 'cm'], default: 'inches' }
                  },
                  required: ['handMeasurement']
                }
              },
              {
                name: 'calculatePaddleWeight',
                description: 'Recommends target paddle weight range in ounces based on play style and arm sensitivity.',
                inputSchema: {
                  type: 'object',
                  properties: {
                    playStyle: { type: 'string', enum: ['quick', 'all-around', 'power'] },
                    armSensitivity: { type: 'string', enum: ['none', 'mild', 'severe'] }
                  },
                  required: ['playStyle']
                }
              }
            ]
          });
        } catch (e) {}
      }
    </script>
  </body>
</html>
