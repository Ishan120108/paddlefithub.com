---
/**
 * Contact page — displays contact information.
 * Static-friendly (no backend required for Cloudflare Pages).
 */
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Contact' },
];
---

<Layout
  title="Contact PaddleFitHub — Get in Touch"
  description="Have questions, feedback, or suggestions for PaddleFitHub? Reach out to us. We'd love to hear from pickleball players."
  canonicalPath="/contact/"
>
  <div class="bg-canvas-soft">
    <div class="container-narrow py-12 md:py-16">
      <Breadcrumbs items={breadcrumbs} />

      <h1 class="text-display-xl text-ink mb-4">Get in touch.</h1>
      <p class="text-body-lg text-body mb-10 max-w-lg">
        Have a question about our calculators, a suggestion for a new tool, or found a bug? We would love to hear from you.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Contact Form -->
        <div class="bg-canvas rounded-lg p-6 md:p-8" style={`box-shadow: var(--shadow-level-4);`}>
          <h2 class="text-display-sm text-ink mb-6">Send us a message</h2>

          <form id="contact-form" class="space-y-5" action="https://formspree.io/f/placeholder" method="POST">
            <div>
              <label for="contact-name" class="text-body-sm-strong text-ink block mb-1">Name</label>
              <input type="text" id="contact-name" name="name" class="form-input" placeholder="Your name" required />
            </div>

            <div>
              <label for="contact-email" class="text-body-sm-strong text-ink block mb-1">Email</label>
              <input type="email" id="contact-email" name="email" class="form-input" placeholder="you@example.com" required />
            </div>

            <div>
              <label for="contact-subject" class="text-body-sm-strong text-ink block mb-1">Subject</label>
              <select id="contact-subject" name="subject" class="form-select">
                <option value="question">Question about a calculator</option>
                <option value="suggestion">Feature suggestion</option>
                <option value="bug">Bug report</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div>
              <label for="contact-message" class="text-body-sm-strong text-ink block mb-1">Message</label>
              <textarea
                id="contact-message"
                name="message"
                class="form-input"
                style="height: 120px; padding-top: 8px; resize: vertical;"
                placeholder="Tell us what's on your mind..."
                required
              ></textarea>
            </div>

            <button type="submit" class="btn-primary w-full">Send Message</button>
          </form>

          <p class="text-caption text-mute mt-4">
            We typically respond within 1–2 business days.
          </p>
        </div>

        <!-- Contact Info -->
        <div class="space-y-6">
          <div class="card-soft">
            <h3 class="text-display-sm text-ink mb-2">Email</h3>
            <p class="text-body-md text-body m-0">
              <a href="mailto:hello@paddlefithub.com" class="text-link hover:underline">hello@paddlefithub.com</a>
            </p>
          </div>

          <div class="card-soft">
            <h3 class="text-display-sm text-ink mb-2">Feedback</h3>
            <p class="text-body-sm text-body m-0">
              Our calculators are constantly improving. If you have ideas for new features, better formulas,
              or additional tools, we genuinely want to hear them.
            </p>
          </div>

          <div class="card-soft">
            <h3 class="text-display-sm text-ink mb-2">Bug reports</h3>
            <p class="text-body-sm text-body m-0">
              If a calculator gives you an unexpected result, let us know your inputs and what you expected.
              This helps us fix issues quickly.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
