---
import Layout from '../layouts/Layout.astro';
import ToolCard from '../components/ToolCard.astro';

const tools = [
  {
    title: 'Grip Size Calculator',
    description: 'Exact Vernier measurement & height-based estimation rounded to standard 1/8" paddle sizes.',
    href: '/tools/grip-size-calculator/',
    tag: 'ESSENTIAL',
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 11V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0"/><path d="M14 10V4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v2"/><path d="M10 10.5V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v8"/><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 13"/></svg>'
  },
  {
    title: 'Paddle Weight Advisor',
    description: 'Find your target weight range (7.2 – 8.8 oz) balancing hand speed, stability, and drive power.',
    href: '/tools/paddle-weight-advisor/',
    tag: 'PERFORMANCE',
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>'
  },
  {
    title: 'Paddle Shape Fit',
    description: 'Compare Standard (16"×8"), Hybrid (16.25"×7.8"), and Elongated (16.5"×7.5") geometric fits.',
    href: '/tools/paddle-shape-fit/',
    tag: 'SPECS',
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M12 6v12"/><path d="M2 12h20"/></svg>'
  },
  {
    title: 'Core Thickness Advisor',
    description: 'Understand 14mm, 16mm, and 20mm core physics tradeoffs for pop vs soft reset touch.',
    href: '/tools/core-thickness-advisor/',
    tag: 'PHYSICS',
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v20"/><path d="M2 5h20"/><path d="M3 3v4"/><path d="M17 3v4"/><path d="M21 3v4"/><path d="M2 19h20"/><path d="M3 17v4"/><path d="M7 17v4"/><path d="M17 17v4"/><path d="M21 17v4"/></svg>'
  },
  {
    title: 'Overgrip Weight Adjustment',
    description: 'Calculate static mass addition (+7g), grip expansion (+1/16"), and handle balance shift.',
    href: '/tools/overgrip-weight-adjustment/',
    tag: 'ADJUSTMENT',
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2v20"/><path d="M2 12h20"/></svg>'
  },
  {
    title: 'Arm Comfort Recommendation Tool',
    description: 'Equipment spec recommendations focused on shock absorption and vibration reduction.',
    href: '/tools/arm-friendly-paddle-finder/',
    tag: 'COMFORT',
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>'
  },
  {
    title: 'Round-Robin Generator',
    description: 'Fair tournament and rec play rotation schedules for Doubles (2v2) and Singles (1v1).',
    href: '/tools/round-robin-generator/',
    tag: 'EVENT',
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 1 0 7.75"/></svg>'
  },
];

const benefits = [
  {
    title: '100% Free & No Sign-up Required',
    description: 'Every calculator is completely free to use. No account creation, popups, or paywalls.'
  },
  {
    title: 'Researched Bio-Mechanics & Physics',
    description: 'Formulas built around real paddle dimensions, USA Pickleball rules, and hand ergonomics.'
  },
  {
    title: 'Instant Results Saved to Your Device',
    description: 'Calculations run instantly in your browser and automatically remember your setup choices.'
  },
];
---

<Layout
  title="Free Pickleball Calculator Suite | PaddleFitHub"
  description="Seven free pickleball calculators for grip size, paddle weight, shape, core thickness, overgrip adjustment, and round-robin scheduling. Instant results, no sign-up."
  canonicalPath="/"
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-canvas" id="hero">
    <div class="absolute inset-0 opacity-20 pointer-events-none" aria-hidden="true">
      <div class="absolute inset-0" style="background: radial-gradient(ellipse at 20% 50%, #007cf0 0%, transparent 50%), radial-gradient(ellipse at 60% 20%, #00dfd8 0%, transparent 40%), radial-gradient(ellipse at 80% 60%, #7928ca 0%, transparent 50%), radial-gradient(ellipse at 40% 80%, #ff0080 0%, transparent 40%), radial-gradient(ellipse at 90% 30%, #f9cb28 0%, transparent 35%);"></div>
    </div>
    <div class="container-page relative py-20 md:py-28 lg:py-32">
      <div class="max-w-3xl">
        <div class="badge-mono mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-deep inline-block"></span>
          paddlefithub.com
        </div>
        <h1 class="text-display-xl text-ink mb-6">Free pickleball calculator suite.</h1>
        <p class="text-body-lg text-body mb-8 max-w-2xl">
          Data-driven tools to help you find the right grip size, paddle weight, shape, core thickness, and more — so you can play with confidence.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/tools/grip-size-calculator/" aria-label="Start with Grip Size Calculator" class="btn-primary">
            Start with Grip Size Calculator
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="#tools" aria-label="Explore All 7 Tools" class="btn-secondary">Explore All 7 Tools</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Tools Hub Grid Section -->
  <section class="bg-canvas-soft py-16 md:py-24 border-t border-hairline" id="tools">
    <div class="container-page">
      <div class="mb-10 flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <p class="text-caption-mono text-mute uppercase tracking-wide mb-2">Calculator Suite</p>
          <h2 class="text-display-lg text-ink">Calculators built for precision.</h2>
        </div>
        <p class="text-body-sm text-mute max-w-sm m-0">
          Select any tool below to analyze your equipment baseline or tournament schedule.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {tools.map((tool) => (
          <ToolCard title={tool.title} description={tool.description} href={tool.href} icon={tool.icon} tag={tool.tag} />
        ))}
      </div>
    </div>
  </section>

  <!-- Trust Benefits Section -->
  <section class="bg-ink py-16 md:py-24 text-on-primary" id="benefits">
    <div class="container-page">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <p class="text-caption-mono text-hairline-strong uppercase tracking-wide mb-2">Why Players Trust PaddleFitHub</p>
        <h2 class="text-display-lg text-on-primary">Data-driven equipment confidence.</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {benefits.map((benefit) => (
          <div class="bg-white/5 border border-white/10 rounded-lg p-6 text-center">
            <h3 class="text-display-sm text-on-primary mb-3 font-semibold">{benefit.title}</h3>
            <p class="text-body-sm text-hairline-strong m-0">{benefit.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Guide Section -->
  <section class="bg-canvas py-16 md:py-24 border-t border-hairline" id="about-calculators">
    <div class="container-page">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-display-lg text-ink mb-6">Your complete guide to choosing the right paddle.</h2>
        <div class="space-y-5 text-body-md text-body">
          <p>
            Finding the right pickleball paddle isn't just about brand names or what your friends are using — it's about matching specs to the way you actually play. Grip size, weight, shape, core thickness, and even overgrip layering all affect how a paddle performs in your hand. We built this free pickleball calculator suite so you can make confident, data-backed decisions without the guesswork.
          </p>

          <h3 class="text-display-sm text-ink">Grip size calculator</h3>
          <p>
            Grip size is the foundation of paddle comfort. Too large, and you lose wrist snap and control. Too small, and you'll over-grip, leading to blisters and forearm tension. Our <a href="/tools/grip-size-calculator/" class="text-link hover:underline">grip size calculator</a> uses either a direct hand measurement or a height-based estimate, then rounds to the nearest standard 1/8" increment. It also accounts for overgrip layers and includes a visual grip size chart so you can double-check your result. Works for all hand sizes — men, women, and juniors.
          </p>

          <h3 class="text-display-sm text-ink">Paddle weight advisor</h3>
          <p>
            Weight determines the feel of every shot. Lighter paddles give you faster hands at the kitchen line, while heavier ones add stability and drive power from the baseline. The <a href="/tools/paddle-weight-advisor/" class="text-link hover:underline">paddle weight advisor</a> asks about your play style, arm sensitivity, and typical session length to recommend a target weight range between 7.2 and 8.8 oz. If you're experimenting with lead tape or weight placement, the result gives you a clear baseline to start from.
          </p>

          <h3 class="text-display-sm text-ink">Paddle shape guide</h3>
          <p>
            Standard (16" × 8"), Hybrid (16.25" × 7.8"), or Elongated (16.5" × 7.5") — each shape trades off sweet spot size, reach, and maneuverability differently. The <a href="/tools/paddle-shape-fit/" class="text-link hover:underline">paddle shape guide</a> scores all three against your play style and ranks your top two fits side by side. Especially useful when comparing paddles from different brands that use different naming conventions for the same shapes.
          </p>

          <h3 class="text-display-sm text-ink">Core thickness advisor</h3>
          <p>
            Core thickness is one of the least understood paddle specs, but it has a major impact on how the ball feels off the face. Thinner cores (14mm) produce more pop and a crisper response; thicker cores (16–20mm) absorb more energy, giving you a softer touch and less vibration transferred to your arm. The <a href="/tools/core-thickness-advisor/" class="text-link hover:underline">core thickness advisor</a> weighs your preferences for power, control, and comfort to suggest the right thickness for your game.
          </p>

          <h3 class="text-display-sm text-ink">Overgrip weight adjustment</h3>
          <p>
            Every overgrip layer adds roughly 7 grams to your paddle and increases the grip circumference by about 1/16". That might sound small, but it shifts the balance point toward the handle and changes how the paddle swings. The <a href="/tools/overgrip-weight-adjustment/" class="text-link hover:underline">overgrip calculator</a> shows the exact impact of one, two, or more layers — helpful if you're fine-tuning feel or managing grip comfort in humid conditions.
          </p>

          <h3 class="text-display-sm text-ink">Arm-friendly paddle finder</h3>
          <p>
            Arm pain is one of the most common complaints among regular players, and equipment choice can either help or make it worse. The <a href="/tools/arm-friendly-paddle-finder/" class="text-link hover:underline">arm-friendly paddle finder</a> generates spec recommendations focused on minimizing vibration and reducing impact shock. It considers core thickness, weight, and grip size together, then builds a primary and backup setup designed to keep you playing without discomfort.
          </p>

          <h3 class="text-display-sm text-ink">Round robin generator</h3>
          <p>
            Organizing fair rotations for rec play or a local tournament is harder than it looks — especially with odd numbers or limited courts. The <a href="/tools/round-robin-generator/" class="text-link hover:underline">round robin generator</a> creates balanced schedules for any group size, whether you're running doubles with 8 players on 2 courts or a larger bracket. Every schedule ensures equal partnerships, balanced opponents, and fair bye rotations. Results are printable and ready for the courts.
          </p>

          <h3 class="text-display-sm text-ink">How to get started</h3>
          <p>
            If you're new to paddle fitting, start with grip size — it's the single most impactful spec for day-to-day comfort. From there, explore paddle weight and shape to narrow down what feels right for your game. Every tool on PaddleFitHub is completely free, runs instantly in your browser, and remembers your inputs locally so you can pick up where you left off.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner Section -->
  <section class="bg-canvas py-16 md:py-20 border-t border-hairline" id="cta">
    <div class="container-page text-center max-w-2xl mx-auto">
      <h2 class="text-display-lg text-ink mb-4">Ready to optimize your paddle?</h2>
      <p class="text-body-lg text-body mb-8">
        Start with grip size — the essential foundation of comfort, wrist snap, and fatigue reduction.
      </p>
      <a href="/tools/grip-size-calculator/" aria-label="Calculate My Grip Size" class="btn-primary inline-flex">
        Calculate My Grip Size
      </a>
    </div>
  </section>
</Layout>