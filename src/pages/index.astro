        },
        {
          "@type": "Person",
          "@id": "https://paddlefithub.com/about#author",
          "name": "Ishan Sahu",
          "jobTitle": "Pickleball Equipment Researcher & Founder",
          "worksFor": {
            "@id": "https://paddlefithub.com/#organization"
          },
          "url": "https://paddlefithub.com/about#author",
          "description": "Recreational pickleball player and equipment researcher dedicated to transparent, data-driven paddle sizing and comfort analysis."
        }
      ]
    }
  </script>
</Layout>