---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import FAQSection from '../../components/FAQSection.astro';

const relatedTools = [
  {
    title: 'Grip Size Calculator',
    description: 'Find your ideal grip size using a hand measurement.',
    href: '/tools/grip-size-calculator/',
  },
  {
    title: 'Core Thickness Advisor',
    description: 'Understand 14 mm, 16 mm, and 20 mm core tradeoffs.',
    href: '/tools/core-thickness-advisor/',
  },
  {
    title: 'Arm Comfort Recommendation Tool',
    description: 'Find specs that minimize vibration and strain.',
    href: '/tools/arm-friendly-paddle-finder/',
  },
];

const faqs = [
  {
    question: 'What weight pickleball paddle should I use?',
    answer: 'Most players perform best with a midweight paddle between 7.8 and 8.2 oz. Midweight paddles provide an optimal balance of kitchen hand speed and drive stability. Lightweight paddles (7.3–7.7 oz) favor fast resets, while heavyweight paddles (8.3+ oz) maximize power.',
  },
  {
    question: 'What is the best weight for a pickleball paddle?',
    answer: 'The best weight depends on your play style and arm health. For all-around play, 7.9 to 8.1 oz is considered the sweet spot. If you suffer from arm fatigue or tennis elbow, a midweight paddle (7.8–8.0 oz) with a thick core is ideal to absorb impact shock without straining your joint.',
  },
  {
    question: 'What is twist weight in a pickleball paddle?',
    answer: 'Twist weight measures a paddle\'s resistance to twisting when hit off-center. A higher twist weight expands the sweet spot and stabilizes the paddle face on mis-hits, whereas lower twist weight makes the paddle feel more maneuverable but less forgiving.',
  },
  {
    question: 'Where to put weight on a pickleball paddle and how to add weight with lead tape?',
    answer: 'You can customize weight distribution using 3g-per-strip lead or tungsten weight tape. Adding weight at the 3 and 9 o\'clock sides increases twist weight and sweet spot size. Placing weight at 12 o\'clock boosts drive power, while weighting the throat (4 and 8 o\'clock) adds stability without slowing hand speed.',
  },
  {
    question: 'How to add weight to a pickleball paddle safely?',
    answer: 'Clean the edge guard with rubbing alcohol, apply 2–4 inch strips of lead or tungsten weight tape symmetrically on both sides of the frame, and cover the tape with electrical tape or an edge guard wrap to prevent peeling.',
  },
  {
    question: 'What is the lightest weight pickleball paddle available?',
    answer: 'The lightest commercial pickleball paddles weigh around 6.8 to 7.2 ounces. While ultralight paddles offer explosive hand speed at the kitchen, they lack mass to absorb ball impact, transferring more vibration to your arm and offering less pop on baseline drives.',
  },
  {
    question: 'How much weight can a paddle board hold vs what size paddle board do I need for my weight?',
    answer: 'Stand-up paddle boards (SUPs) typically hold 200 to 350+ lbs depending on volume (liters). While SUP weight capacities refer to water displacement, pickleball paddle weight (7.2–8.8 oz) refers to static racket weight—a key distinction when evaluating equipment weight specs.',
  },
];
---

<CalculatorLayout
  title="Pickleball Paddle Weight Guide | PaddleFitHub"
  description="Get personalized paddle weight recommendations based on play style, arm sensitivity, and experience level. Covers the 7.2–8.8 oz range with tradeoff analysis."
  heading="Paddle weight advisor."
  intro="Your paddle's weight affects hand speed, power, and arm endurance. Answer a few questions about your play style and this tool will recommend the right weight range for you."
  canonicalPath="/tools/paddle-weight-advisor/"
  relatedTools={relatedTools}
>
  <!-- 1. TOP SECTION: INTERACTIVE CALCULATOR TOOL -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12" id="weight-calculator">
    <!-- ── Left Column: Form Inputs ── -->
    <div>
      <h2 class="text-display-sm text-ink mb-6">1. Primary play style</h2>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6" id="play-style-group">
        <button
          type="button"
          data-value="quick"
          class="style-option bg-canvas-soft border-2 border-hairline p-4 rounded-lg text-center cursor-pointer transition-all hover:border-hairline-strong text-ink"
        >
          <div class="text-display-sm mb-1">⚡</div>
          <div class="text-body-sm-strong text-ink">Quick Hands</div>
          <div class="text-caption text-mute mt-1">Dinks, resets, fast volleys</div>
        </button>
        <button
          type="button"
          data-value="allround"
          class="style-option bg-canvas-soft border-2 border-hairline p-4 rounded-lg text-center cursor-pointer transition-all hover:border-hairline-strong text-ink"
        >
          <div class="text-display-sm mb-1">🎯</div>
          <div class="text-body-sm-strong text-ink">All-Around</div>
          <div class="text-caption text-mute mt-1">Balanced all-court mix</div>
        </button>
        <button
          type="button"
          data-value="power"
          class="style-option bg-canvas-soft border-2 border-hairline p-4 rounded-lg text-center cursor-pointer transition-all hover:border-hairline-strong text-ink"
        >
          <div class="text-display-sm mb-1">💪</div>
          <div class="text-body-sm-strong text-ink">Power / Attacker</div>
          <div class="text-caption text-mute mt-1">Drives, smashes, pop</div>
        </button>
      </div>
      <p class="text-caption text-error mb-4 hidden" id="style-error">Please select a primary play style above.</p>

      <h2 class="text-display-sm text-ink mb-4 pt-4 border-t border-hairline">2. Player &amp; session factors</h2>

      <div class="mb-6">
        <label for="arm-sensitivity" class="text-body-sm-strong text-ink block mb-1">Arm &amp; joint sensitivity</label>
        <p class="text-caption text-mute mb-2">Do you have a history of tennis elbow, golfer's elbow, or shoulder fatigue?</p>
        <select id="arm-sensitivity" class="form-select">
          <option value="none">Normal — No arm discomfort history</option>
          <option value="mild">Mild — Occasional soreness or tight forearm</option>
          <option value="significant">Sensitive — History of elbow/shoulder strain</option>
        </select>
      </div>

      <div class="mb-6">
        <label for="session-length" class="text-body-sm-strong text-ink block mb-1">Typical play session duration</label>
        <select id="session-length" class="form-select">
          <option value="short">Under 1 hour (Quick sessions)</option>
          <option value="medium" selected>1 – 2 hours (Standard rec play)</option>
          <option value="long">Over 2 hours (Long open-play marathons)</option>
        </select>
      </div>

      <div class="mb-6">
        <label for="experience" class="text-body-sm-strong text-ink block mb-1">Experience level</label>
        <select id="experience" class="form-select">
          <option value="beginner">Beginner (Building fundamental mechanics)</option>
          <option value="intermediate" selected>Intermediate (Consistent rallies &amp; strategy)</option>
          <option value="advanced">Advanced (Competitive tournament play)</option>
        </select>
      </div>

      <button type="button" id="calc-weight-btn" class="btn-primary w-full sm:w-auto">
        Calculate Weight Range
      </button>
    </div>

    <!-- ── Right Column: Results Panel ── -->
    <div>
      <div id="weight-placeholder" class="flex flex-col items-center justify-center h-full min-h-80 text-center p-8 border border-dashed border-hairline rounded-lg bg-canvas-soft/50">
        <div class="w-16 h-16 rounded-full bg-canvas-soft-2 flex items-center justify-center mb-4 text-mute">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
          </svg>
        </div>
        <h3 class="text-body-md-strong text-ink mb-1">Select your play style</h3>
        <p class="text-body-sm text-mute max-w-xs">Pick a play style on the left to generate your target paddle weight range and performance tradeoffs.</p>
      </div>

      <div id="weight-results" class="hidden space-y-6">
        <div class="bg-ink text-on-primary rounded-lg p-6 relative overflow-hidden">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
            <span class="text-caption-mono text-hairline-strong uppercase tracking-wide">Recommended Weight Range</span>
            <span id="confidence-badge" class="inline-block self-start sm:self-auto px-2.5 py-1 rounded-full text-caption-mono text-xs leading-normal max-w-full whitespace-normal bg-canvas/10 text-on-primary">
              Tailored Fit
            </span>
          </div>

          <p class="text-display-xl text-on-primary font-semibold mb-1" id="weight-range">7.8 – 8.2 oz</p>
          <p class="text-body-sm text-hairline-strong mb-4" id="weight-grams">221 – 232 grams</p>

          <div class="pt-4 border-t border-white/10 text-caption text-hairline" id="weight-math-breakdown">
          </div>
        </div>

        <div class="bg-canvas-soft rounded-lg p-5 border border-hairline space-y-4">
          <h3 class="text-body-sm-strong text-ink">Performance Tradeoffs</h3>

          <div>
            <div class="flex justify-between text-caption mb-1">
              <span class="text-ink font-medium">Hand Speed / Net Maneuverability</span>
              <span class="text-mute" id="bar-speed-val">85%</span>
            </div>
            <div class="h-2 bg-canvas-soft-2 rounded-full overflow-hidden">
              <div class="h-full bg-ink rounded-full transition-all duration-500" id="bar-speed" style="width: 85%"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between text-caption mb-1">
              <span class="text-ink font-medium">Off-Center Stability / Twist Resistance</span>
              <span class="text-mute" id="bar-stability-val">75%</span>
            </div>
            <div class="h-2 bg-canvas-soft-2 rounded-full overflow-hidden">
              <div class="h-full bg-ink rounded-full transition-all duration-500" id="bar-stability" style="width: 75%"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between text-caption mb-1">
              <span class="text-ink font-medium">Plough-Through Power / Drive Mass</span>
              <span class="text-mute" id="bar-power-val">65%</span>
            </div>
            <div class="h-2 bg-canvas-soft-2 rounded-full overflow-hidden">
              <div class="h-full bg-ink rounded-full transition-all duration-500" id="bar-power" style="width: 65%"></div>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="bg-canvas-soft rounded-lg p-4 border border-hairline">
            <span class="text-caption-mono text-mute uppercase tracking-wide block mb-1">✓ Best for</span>
            <p class="text-body-sm text-ink font-medium" id="best-for-text">—</p>
          </div>
          <div class="bg-canvas-soft rounded-lg p-4 border border-hairline">
            <span class="text-caption-mono text-mute uppercase tracking-wide block mb-1">✗ Avoid if</span>
            <p class="text-body-sm text-ink font-medium" id="avoid-if-text">—</p>
          </div>
        </div>

        <div id="long-session-note" class="hidden bg-cyan-soft/30 border border-cyan-deep/20 rounded-lg p-4">
          <p class="text-body-sm-strong text-ink mb-1">⏱ Long Session Advisory (&gt;2 Hours)</p>
          <p class="text-caption text-body">For sessions exceeding 2 hours, cumulative forearm fatigue sets in. Aim for the lower end of your recommended target range to preserve reaction speed in late games.</p>
        </div>

        <div id="beginner-note" class="hidden bg-violet-soft/30 border border-violet-deep/20 rounded-lg p-4">
          <p class="text-body-sm-strong text-ink mb-1">🎓 Beginner Development Note</p>
          <p class="text-caption text-body">As a beginner, a mid-to-light weight paddle allows you to develop clean stroke mechanics and quick preparation without fighting heavy paddle inertia.</p>
        </div>

        <div class="bg-canvas-soft rounded-lg p-5 border border-hairline space-y-2">
          <h3 class="text-body-sm-strong text-ink">Calculation methodology</h3>
          <div class="text-body-sm text-body space-y-2" id="weight-explanation-content">
          </div>
        </div>

        <div class="pt-4 border-t border-hairline">
          <h3 class="text-body-sm-strong text-ink mb-3">Recommended next steps</h3>
          <div class="space-y-2">
            <a href="/tools/core-thickness-advisor/" class="flex items-center gap-2 text-body-sm text-link hover:underline">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7H11M11 7L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Pair weight with the right core thickness (14mm vs 16mm vs 20mm)
            </a>
            <a href="/tools/arm-friendly-paddle-finder/" class="flex items-center gap-2 text-body-sm text-link hover:underline">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7H11M11 7L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              View arm-friendly specs for vibration reduction
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 2. STEP-BY-STEP GUIDE SECTION -->
  <section class="mt-12 pt-8 border-t border-hairline">
    <h2 class="text-display-sm text-ink mb-4">How to Use This Tool</h2>
    <ol class="list-decimal pl-5 space-y-2 text-body-sm text-body">
      <li><strong>Select your primary play style:</strong> Choose <em>Quick Hands</em> (dinks &amp; net battles), <em>All-Around</em> (balanced all-court play), or <em>Power / Attacker</em> (drives &amp; smashes).</li>
      <li><strong>Specify arm sensitivity:</strong> Indicate if you have any history of elbow soreness or joint discomfort.</li>
      <li><strong>Set session duration:</strong> Select your typical playing time (<1 hr, 1–2 hrs, or >2 hr marathons).</li>
      <li><strong>Select experience level:</strong> Choose Beginner, Intermediate, or Advanced.</li>
      <li><strong>Click Calculate Weight Range:</strong> Review your target weight range in ounces &amp; grams, 3-bar performance tradeoffs, and <em>Best for / Avoid if</em> guidelines.</li>
    </ol>
  </section>

  <!-- 3. FORMULA & CALCULATION METHOD SECTION -->
  <section class="mt-8 pt-8 border-t border-hairline">
    <h2 class="text-display-sm text-ink mb-3">How the Result is Calculated</h2>
    <p class="text-body-sm text-body mb-4">
      We start with an established baseline weight class matching your play style: Lightweight (7.3–7.7 oz), Midweight (7.8–8.2 oz), or Heavyweight (8.3–8.8 oz). Next, we apply small numerical modifiers (−0.1 oz for mild arm sensitivity or long sessions; +0.1 oz for short sessions or advanced stability). Finally, the target range is clamped between 7.2 oz and 8.8 oz to match commercial market availability.
    </p>

    <div class="bg-canvas-soft p-4 rounded-md font-mono text-caption border border-hairline space-y-1">
      <div>Quick Base = [7.3, 7.7] oz | All-Around Base = [7.8, 8.2] oz | Power Base = [8.3, 8.8] oz</div>
      <div>Low = Base_Low + Arm_Delta + Session_Delta + Exp_Delta</div>
      <div>High = Base_High + Arm_Delta + Session_Delta + Exp_Delta</div>
      <div>Final Weight Range = ClampedTo[7.2 oz, 8.8 oz](Low, High)</div>
    </div>
  </section>

  <!-- 4. REAL-WORLD EXAMPLES SECTION -->
  <section class="mt-8 pt-8 border-t border-hairline">
    <h2 class="text-display-sm text-ink mb-4">Real-World Examples</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-canvas-soft p-4 rounded-lg border border-hairline">
        <span class="text-caption-mono text-mute uppercase block mb-1">Example A: Quick Hands + Elbow Protection</span>
        <p class="text-body-sm text-ink font-medium mb-1">Quick Hands style, mild elbow soreness, 2+ hour sessions</p>
        <p class="text-caption text-body">
          Base: [7.3, 7.7] oz − 0.1 oz (elbow) − 0.1 oz (session) = <strong>7.2 – 7.5 oz (204 – 213g)</strong>. Sizing slightly lighter keeps kitchen hands fast while preventing cumulative arm strain.
        </p>
      </div>

      <div class="bg-canvas-soft p-4 rounded-lg border border-hairline">
        <span class="text-caption-mono text-mute uppercase block mb-1">Example B: Power Attacker + Advanced Stability</span>
        <p class="text-body-sm text-ink font-medium mb-1">Power Attacker style, no arm issues, advanced level</p>
        <p class="text-caption text-body">
          Base: [8.3, 8.8] oz + 0.1 oz (advanced level) = <strong>8.4 – 8.8 oz (238 – 249g)</strong>. Higher static mass delivers maximum plough-through power on baseline drives.
        </p>
      </div>
    </div>
  </section>

  <!-- Related Guide Banner -->
  <div class="mt-8 p-4 bg-canvas-soft border border-hairline rounded-lg flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
    <div>
      <p class="text-body-sm-strong text-ink m-0">Want to explore static weight vs. swing weight trade-offs?</p>
      <p class="text-caption text-mute m-0">Read our in-depth article analyzing light (7.0–7.5 oz), mid (7.5–8.0 oz), and heavy (8.0–8.5 oz) options.</p>
    </div>
    <a href="/blog/paddle-weight-guide/" class="btn-secondary text-caption whitespace-nowrap shrink-0">Read Weight Guide →</a>
  </div>

  <!-- FAQ Section -->
  <FAQSection title="Pickleball Paddle Weight FAQs" faqs={faqs} />
</CalculatorLayout>

<script>
  type PlayStyle = 'quick' | 'allround' | 'power';
  const STORAGE_KEY = 'paddlefit_weight_advisor_state';

  let selectedStyle: PlayStyle | null = null;

  const styleButtons = document.querySelectorAll('.style-option') as NodeListOf<HTMLButtonElement>;
  const styleError = document.getElementById('style-error') as HTMLParagraphElement;

  const armSelect = document.getElementById('arm-sensitivity') as HTMLSelectElement;
  const sessionSelect = document.getElementById('session-length') as HTMLSelectElement;
  const expSelect = document.getElementById('experience') as HTMLSelectElement;

  const calcBtn = document.getElementById('calc-weight-btn') as HTMLButtonElement;

  const placeholder = document.getElementById('weight-placeholder') as HTMLDivElement;
  const results = document.getElementById('weight-results') as HTMLDivElement;

  const weightRangeEl = document.getElementById('weight-range') as HTMLParagraphElement;
  const weightGramsEl = document.getElementById('weight-grams') as HTMLParagraphElement;
  const confidenceBadge = document.getElementById('confidence-badge') as HTMLSpanElement;

  const mathBreakdown = document.getElementById('weight-math-breakdown') as HTMLDivElement;
  const bestForText = document.getElementById('best-for-text') as HTMLParagraphElement;
  const avoidIfText = document.getElementById('avoid-if-text') as HTMLParagraphElement;

  const barSpeed = document.getElementById('bar-speed') as HTMLDivElement;
  const barSpeedVal = document.getElementById('bar-speed-val') as HTMLSpanElement;
  const barStability = document.getElementById('bar-stability') as HTMLDivElement;
  const barStabilityVal = document.getElementById('bar-stability-val') as HTMLSpanElement;
  const barPower = document.getElementById('bar-power') as HTMLDivElement;
  const barPowerVal = document.getElementById('bar-power-val') as HTMLSpanElement;

  const longSessionNote = document.getElementById('long-session-note') as HTMLDivElement;
  const beginnerNote = document.getElementById('beginner-note') as HTMLDivElement;
  const explanationContent = document.getElementById('weight-explanation-content') as HTMLDivElement;

  function selectStyle(style: PlayStyle) {
    selectedStyle = style;
    styleError.classList.add('hidden');
    styleButtons.forEach(btn => {
      if (btn.dataset.value === style) {
        btn.classList.add('border-ink', 'bg-canvas-soft');
        btn.classList.remove('border-hairline');
      } else {
        btn.classList.remove('border-ink');
        btn.classList.add('border-hairline');
      }
    });
  }

  styleButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      selectStyle(btn.dataset.value as PlayStyle);
    });
  });

  function calculate() {
    if (!selectedStyle) {
      styleError.classList.remove('hidden');
      return;
    }

    const arm = armSelect.value;
    const session = sessionSelect.value;
    const exp = expSelect.value;

    const baseRanges: Record<PlayStyle, [number, number]> = {
      quick: [7.3, 7.7],
      allround: [7.8, 8.2],
      power: [8.3, 8.8],
    };

    let [low, high] = baseRanges[selectedStyle];
    const deltas: string[] = [];

    if (arm === 'mild') {
      low -= 0.1;
      high -= 0.1;
      deltas.push('−0.1 oz for mild arm sensitivity');
    } else if (arm === 'significant') {
      low -= 0.2;
      high -= 0.2;
      deltas.push('−0.2 oz for joint discomfort history');
    }

    if (session === 'long') {
      low -= 0.1;
      high -= 0.1;
      deltas.push('−0.1 oz for long (>2 hr) play sessions');
    } else if (session === 'short') {
      high += 0.1;
      deltas.push('+0.1 oz for short (<1 hr) sessions');
    }

    if (exp === 'beginner') {
      low -= 0.1;
      high -= 0.1;
      deltas.push('−0.1 oz for beginner technical development');
    } else if (exp === 'advanced') {
      low += 0.1;
      high += 0.1;
      deltas.push('+0.1 oz for advanced stability');
    }

    low = Math.round(low * 10) / 10;
    high = Math.round(high * 10) / 10;

    low = Math.max(7.2, Math.min(8.7, low));
    high = Math.max(low + 0.3, Math.min(8.8, high));

    const lowGrams = Math.round(low * 28.3495);
    const highGrams = Math.round(high * 28.3495);
    const midWeight = (low + high) / 2;

    placeholder.classList.add('hidden');
    results.classList.remove('hidden');

    weightRangeEl.textContent = `${low.toFixed(1)} – ${high.toFixed(1)} oz`;
    weightGramsEl.textContent = `${lowGrams} – ${highGrams} grams`;

    const isCustomized = arm !== 'none' || session !== 'medium' || exp !== 'intermediate';
    confidenceBadge.textContent = isCustomized ? 'Tailored Recommendation' : 'Best Starting Range';

    let breakdownHTML = `Base range for ${selectedStyle.toUpperCase()}: ${baseRanges[selectedStyle][0].toFixed(1)}–${baseRanges[selectedStyle][1].toFixed(1)} oz.`;
    if (deltas.length > 0) {
      breakdownHTML += `<br>Adjustments: ${deltas.join('; ')}.`;
    }
    mathBreakdown.innerHTML = breakdownHTML;

    const speedPct = Math.round(100 - ((midWeight - 7.0) / 1.8) * 60);
    const stabilityPct = Math.round(((midWeight - 7.0) / 1.8) * 50 + 45);
    const powerPct = Math.round(((midWeight - 7.0) / 1.8) * 60 + 35);

    barSpeed.style.width = `${speedPct}%`;
    barSpeedVal.textContent = `${speedPct}%`;

    barStability.style.width = `${stabilityPct}%`;
    barStabilityVal.textContent = `${stabilityPct}%`;

    barPower.style.width = `${powerPct}%`;
    barPowerVal.textContent = `${powerPct}%`;

    if (midWeight < 7.6) {
      bestForText.textContent = 'Net kitchen battles, fast dink resets, and players prioritizing arm comfort & fast hands.';
      avoidIfText.textContent = 'You rely on heavy baseline drive pop or play in high-wind outdoor conditions.';
    } else if (midWeight > 8.3) {
      bestForText.textContent = 'Aggressive baseline drives, high-mass put-aways, and Singles players wanting max stability.';
      avoidIfText.textContent = 'You suffer from tennis elbow, wrist stiffness, or perform long 3+ hour session marathons.';
    } else {
      bestForText.textContent = 'All-around players seeking an optimal balance of kitchen quickness, stability, and drive power.';
      avoidIfText.textContent = 'You require an extreme specialty setup (ultralight <7.0 oz or superheavy >9.0 oz).';
    }

    longSessionNote.classList.toggle('hidden', session !== 'long');
    beginnerNote.classList.toggle('hidden', exp !== 'beginner');

    explanationContent.innerHTML = `
      <p>A paddle in the <strong>${low.toFixed(1)} – ${high.toFixed(1)} oz</strong> range fits your ${selectedStyle} profile.</p>
      <p>• <strong>Hand Speed (${speedPct}%):</strong> Lighter weight reduces rotational inertia, letting you bring your paddle up faster during rapid fire kitchen exchanges.</p>
      <p>• <strong>Stability (${stabilityPct}%):</strong> Mass behind the ball keeps the paddle face square on off-center dinks, reducing torque on your wrist.</p>
      <p>• <strong>Power (${powerPct}%):</strong> Static mass adds momentum on drives without needing to swing violently.</p>
    `;

    saveState();
  }

  function saveState() {
    try {
      const data = {
        style: selectedStyle,
        arm: armSelect.value,
        session: sessionSelect.value,
        exp: expSelect.value,
      };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    } catch {}
  }

  function loadState() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const data = JSON.parse(raw);
      if (data.style) selectStyle(data.style as PlayStyle);
      if (data.arm) armSelect.value = data.arm;
      if (data.session) sessionSelect.value = data.session;
      if (data.exp) expSelect.value = data.exp;
    } catch {}
  }

  calcBtn.addEventListener('click', calculate);
  loadState();
</script>