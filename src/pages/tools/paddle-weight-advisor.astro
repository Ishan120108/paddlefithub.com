---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

const relatedTools = [
  {
    title: 'Grip Size Calculator',
    description: 'Find your ideal grip size using a hand measurement.',
    href: '/tools/grip-size-calculator/',
  },
  {
    title: 'Core Thickness Advisor',
    description: 'Understand 14 mm, 16 mm, and 20 mm core tradeoffs.',
    href: '/tools/core-thickness-advisor/',
  },
  {
    title: 'Arm-Friendly Paddle Finder',
    description: 'Find specs that minimize vibration and strain.',
    href: '/tools/arm-friendly-paddle-finder/',
  },
];
---

<CalculatorLayout
  title="Paddle Weight Advisor — Find Your Ideal Paddle Weight | PaddleFitHub"
  description="Get personalized paddle weight recommendations based on your play style, arm sensitivity, session length, and experience level."
  heading="Paddle weight advisor."
  intro="Your paddle weight affects power, control, and fatigue. This tool recommends the right weight range based on how you play."
  canonicalPath="/tools/paddle-weight-advisor/"
  relatedTools={relatedTools}
>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12" id="weight-calculator">
    <!-- Input Form -->
    <div>
      <h2 class="text-display-sm text-ink mb-6">Tell us how you play</h2>

      <div class="mb-6">
        <label class="text-body-sm-strong text-ink block mb-2" id="style-error-label">Primary play style</label>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2" id="play-style-group">
          <button type="button" data-value="quick" class="style-option card-soft text-center p-4 cursor-pointer border-2 border-transparent transition-all rounded-md hover:border-hairline-strong">
            <div class="text-display-sm mb-1">⚡</div>
            <div class="text-body-sm-strong text-ink">Quick Hands</div>
            <div class="text-caption text-mute mt-1">Dinks, resets, fast volleys</div>
          </button>
          <button type="button" data-value="allround" class="style-option card-soft text-center p-4 cursor-pointer border-2 border-transparent transition-all rounded-md hover:border-hairline-strong">
            <div class="text-display-sm mb-1">🎯</div>
            <div class="text-body-sm-strong text-ink">All-Around</div>
            <div class="text-caption text-mute mt-1">Balanced mix of shots</div>
          </button>
          <button type="button" data-value="power" class="style-option card-soft text-center p-4 cursor-pointer border-2 border-transparent transition-all rounded-md hover:border-hairline-strong">
            <div class="text-display-sm mb-1">💪</div>
            <div class="text-body-sm-strong text-ink">Power</div>
            <div class="text-caption text-mute mt-1">Drives, smashes, speed</div>
          </button>
        </div>
        <p class="text-caption text-error mt-1 hidden" id="style-error">Please select a play style first.</p>
      </div>

      <div class="mb-6">
        <label for="arm-sensitivity" class="text-body-sm-strong text-ink block mb-1">Arm sensitivity</label>
        <p class="text-caption text-mute mb-2">Any history of tennis elbow, golfer's elbow, or shoulder issues?</p>
        <select id="arm-sensitivity" class="form-select">
          <option value="none">No arm issues</option>
          <option value="mild">Mild — occasional discomfort</option>
          <option value="significant">Significant — regular pain or past injury</option>
        </select>
      </div>

      <div class="mb-6">
        <label for="session-length" class="text-body-sm-strong text-ink block mb-1">Typical session length</label>
        <select id="session-length" class="form-select">
          <option value="short">Under 1 hour</option>
          <option value="medium">1 – 2 hours</option>
          <option value="long">Over 2 hours</option>
        </select>
      </div>

      <div class="mb-6">
        <label for="experience" class="text-body-sm-strong text-ink block mb-1">Experience level</label>
        <select id="experience" class="form-select">
          <option value="beginner">Beginner (learning fundamentals)</option>
          <option value="intermediate">Intermediate (consistent rallies)</option>
          <option value="advanced">Advanced (competitive play)</option>
        </select>
      </div>

      <button type="button" id="calc-weight-btn" class="btn-primary w-full sm:w-auto">
        Get Recommendation
      </button>
    </div>

    <!-- Results -->
    <div>
      <div id="weight-placeholder" class="flex flex-col items-center justify-center h-full min-h-64 text-center p-6">
        <div class="w-16 h-16 rounded-full bg-canvas-soft-2 flex items-center justify-center mb-4">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-mute"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
        </div>
        <p class="text-body-md text-mute">Select your play style and preferences to get a weight recommendation.</p>
      </div>

      <div id="weight-results" class="hidden">
        <div class="bg-canvas-soft rounded-md p-6 mb-4">
          <div class="flex items-center justify-between mb-1">
            <p class="text-caption-mono text-mute uppercase tracking-wide">Recommended Weight Range</p>
            <span class="badge" id="confidence-badge">Recommendation</span>
          </div>
          <p class="text-display-xl text-ink mb-1" id="weight-range">—</p>
          <p class="text-body-sm text-body" id="weight-grams">—</p>
        </div>

        <div class="mb-6">
          <h3 class="text-body-sm-strong text-ink mb-3">Weight spectrum</h3>
          <div class="relative h-8 bg-canvas-soft-2 rounded-xs overflow-hidden mb-2">
            <div class="absolute inset-y-0 bg-ink/10 rounded-xs transition-all duration-500" id="weight-bar"></div>
            <div class="absolute inset-y-0 flex items-center transition-all duration-500" id="weight-marker">
              <div class="w-1 h-6 bg-ink rounded-full"></div>
            </div>
          </div>
          <div class="flex justify-between text-caption text-mute">
            <span>7.0 oz</span>
            <span>7.5 oz</span>
            <span>8.0 oz</span>
            <span>8.5 oz</span>
          </div>
        </div>

        <div class="mb-6">
          <h3 class="text-body-sm-strong text-ink mb-2">Tradeoff summary</h3>
          <p class="text-body-sm text-body" id="tradeoff-summary"></p>
        </div>

        <div class="grid grid-cols-2 gap-3 mb-6">
          <div class="bg-canvas-soft rounded-md p-4">
            <p class="text-caption-mono text-mute uppercase tracking-wide mb-1">Best for</p>
            <p class="text-body-sm text-ink" id="best-for">—</p>
          </div>
          <div class="bg-canvas-soft rounded-md p-4">
            <p class="text-caption-mono text-mute uppercase tracking-wide mb-1">Avoid if</p>
            <p class="text-body-sm text-ink" id="avoid-if">—</p>
          </div>
        </div>

        <div id="long-session-note" class="hidden mb-4">
          <div class="bg-cyan-soft/30 rounded-md p-4 flex items-start gap-3">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-cyan-deep mt-0.5 flex-shrink-0"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
            <p class="text-caption text-body">For sessions over 2 hours, a lighter paddle reduces cumulative fatigue. Consider the lower end of your range.</p>
          </div>
        </div>

        <div id="beginner-note" class="hidden mb-4">
          <div class="bg-violet-soft/30 rounded-md p-4 flex items-start gap-3">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-violet-deep mt-0.5 flex-shrink-0"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
            <p class="text-caption text-body">As a beginner, a lighter paddle helps you develop proper technique without excess strain. You can move to a heavier paddle as your skills improve.</p>
          </div>
        </div>

        <div class="text-body-sm text-body space-y-2" id="weight-explanation"></div>
      </div>
    </div>
  </div>

  <div class="mt-8 pt-6 border-t border-hairline">
    <p class="text-caption text-mute">
      <strong>Note:</strong> Weight recommendations are general guidelines. Actual paddle feel depends on weight distribution (head-heavy vs. handle-heavy), core material, and face composition. Weights shown are for unweighted paddles before any lead tape or overgrip additions.
    </p>
  </div>
</CalculatorLayout>

<script>
  type PlayStyle = 'quick' | 'allround' | 'power';

  let selectedStyle: PlayStyle | null = null;

  const LIGHT_UPPER = 7.5;
  const MID_LOWER = 7.3;
  const MID_UPPER = 8.0;
  const HEAVY_LOWER = 7.8;

  function loadSaved() {
    const saved = localStorage.getItem('weight-advisor');
    if (!saved) return;
    try {
      const data = JSON.parse(saved);
      if (data.style) {
        selectedStyle = data.style as PlayStyle;
        document.querySelector(`.style-option[data-value="${data.style}"]`)?.click();
      }
      const arm = document.getElementById('arm-sensitivity') as HTMLSelectElement;
      if (data.armSensitivity) arm.value = data.armSensitivity;
      const session = document.getElementById('session-length') as HTMLSelectElement;
      if (data.sessionLength) session.value = data.sessionLength;
      const exp = document.getElementById('experience') as HTMLSelectElement;
      if (data.experience) exp.value = data.experience;
    } catch {}
  }

  function savePreferences(style: string, arm: string, session: string, exp: string) {
    localStorage.setItem('weight-advisor', JSON.stringify({ style, armSensitivity: arm, sessionLength: session, experience: exp }));
  }

  const styleButtons = document.querySelectorAll('.style-option') as NodeListOf<HTMLButtonElement>;
  styleButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      styleButtons.forEach(b => {
        b.classList.remove('border-ink');
        b.classList.add('border-transparent');
      });
      btn.classList.add('border-ink');
      btn.classList.remove('border-transparent');
      selectedStyle = btn.dataset.value as PlayStyle;
      document.getElementById('style-error')!.classList.add('hidden');
    });
  });

  const calcBtn = document.getElementById('calc-weight-btn')!;
  calcBtn.addEventListener('click', () => {
    if (!selectedStyle) {
      document.getElementById('style-error')!.classList.remove('hidden');
      document.getElementById('style-error-label')!.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    const armSensitivity = (document.getElementById('arm-sensitivity') as HTMLSelectElement).value;
    const sessionLength = (document.getElementById('session-length') as HTMLSelectElement).value;
    const experience = (document.getElementById('experience') as HTMLSelectElement).value;

    const baseRanges: Record<PlayStyle, [number, number]> = {
      quick: [7.0, 7.5],
      allround: [7.3, 7.9],
      power: [7.8, 8.5],
    };

    let [low, high] = baseRanges[selectedStyle];
    const adjustments: string[] = [];

    if (armSensitivity === 'mild') {
      low -= 0.2;
      high -= 0.2;
      adjustments.push('-0.2 oz for mild arm sensitivity');
    } else if (armSensitivity === 'significant') {
      low -= 0.3;
      high -= 0.3;
      adjustments.push('-0.3 oz for significant arm sensitivity');
    }

    if (sessionLength === 'long') {
      low -= 0.1;
      high -= 0.1;
      adjustments.push('-0.1 oz for long sessions');
    } else if (sessionLength === 'short') {
      high += 0.1;
      adjustments.push('+0.1 oz for short sessions');
    }

    if (experience === 'beginner') {
      low -= 0.1;
      high -= 0.1;
      adjustments.push('-0.1 oz for beginner');
    } else if (experience === 'advanced') {
      low += 0.1;
      high += 0.1;
      adjustments.push('+0.1 oz for advanced level');
    }

    low = Math.max(6.8, Math.round(low * 10) / 10);
    high = Math.min(8.5, Math.round(high * 10) / 10);
    if (low > high) low = high;

    const lowG = Math.round(low * 28.3495);
    const highG = Math.round(high * 28.3495);

    document.getElementById('weight-placeholder')!.classList.add('hidden');
    document.getElementById('weight-results')!.classList.remove('hidden');
    document.getElementById('weight-range')!.textContent = `${low.toFixed(1)} – ${high.toFixed(1)} oz`;
    document.getElementById('weight-grams')!.textContent = `${lowG} – ${highG} grams`;

    // Confidence badge
    const isTailored = armSensitivity !== 'none' || sessionLength !== 'medium' || experience !== 'intermediate';
    const badge = document.getElementById('confidence-badge')!;
    badge.textContent = isTailored ? 'Tailored recommendation' : 'General guidance';
    badge.className = `badge ${isTailored ? '' : ''}`;

    // Weight bar
    const barStart = ((low - 7.0) / 1.5) * 100;
    const barEnd = ((high - 7.0) / 1.5) * 100;
    const midpoint = (barStart + barEnd) / 2;
    const bar = document.getElementById('weight-bar')!;
    const marker = document.getElementById('weight-marker')!;
    bar.style.left = `${Math.max(0, barStart)}%`;
    bar.style.width = `${Math.min(100, barEnd) - Math.max(0, barStart)}%`;
    marker.style.left = `${Math.max(2, Math.min(98, midpoint))}%`;

    // Tradeoff
    const avg = (low + high) / 2;
    let tradeoff = '';
    if (avg < 7.4) tradeoff = 'Lighter paddles favor <strong>speed and maneuverability</strong> over raw power. Expect quicker hands at the net but less inherent pop on drives. Stability on off-center hits is reduced.';
    else if (avg > 8.0) tradeoff = 'Heavier paddles favor <strong>power and stability</strong> over hand speed. Your drives will have more mass behind them, but transitions at the net will be slower and arm fatigue may increase.';
    else tradeoff = 'Mid-weight paddles offer a <strong>balanced tradeoff between speed, stability, and power</strong>. This is the most versatile range — good for all shot types without extreme compromises.';
    document.getElementById('tradeoff-summary')!.innerHTML = tradeoff;

    // Best for / Avoid if
    const styleNames: Record<PlayStyle, string> = { quick: 'quick hands players', allround: 'all-around players', power: 'power players' };
    document.getElementById('best-for')!.textContent = `${styleNames[selectedStyle]}` + (armSensitivity !== 'none' ? ' prioritizing arm comfort' : '') + (experience === 'beginner' ? ' learning the game' : '');
    document.getElementById('avoid-if')!.textContent = avg < 7.4 ? 'You want maximum power from your paddle weight' : avg > 8.0 ? 'You prioritize quick transitions and minimal fatigue' : 'You want an extreme specialty paddle';

    // Session-specific notes
    const longNote = document.getElementById('long-session-note')!;
    longNote.classList.toggle('hidden', sessionLength !== 'long');
    const beginnerNote = document.getElementById('beginner-note')!;
    beginnerNote.classList.toggle('hidden', experience !== 'beginner');

    // Explanation
    const explanationParts: string[] = [];
    explanationParts.push(`<p class="text-body-sm-strong text-ink mb-1">How this was calculated</p>`);
    explanationParts.push(`<p><strong>Baseline:</strong> ${baseRanges[selectedStyle][0].toFixed(1)} – ${baseRanges[selectedStyle][1].toFixed(1)} oz for ${selectedStyle} play style.</p>`);
    if (adjustments.length) {
      explanationParts.push(`<p><strong>Adjustments:</strong></p><ul class="list-disc pl-5 space-y-0.5 text-body-sm">${adjustments.map(a => `<li>${a}</li>`).join('')}</ul>`);
    }
    explanationParts.push(`<p class="text-caption text-mute mt-2">Final range clamped to realistic market availability (6.8 – 8.5 oz).</p>`);

    document.getElementById('weight-explanation')!.innerHTML = explanationParts.join('');

    savePreferences(selectedStyle, armSensitivity, sessionLength, experience);
  });

  loadSaved();
</script>