---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import FAQSection from '../../components/FAQSection.astro';

const relatedTools = [
  {
    title: 'Paddle Weight Advisor',
    description: 'Find the right weight range for your play style and arm health.',
    href: '/tools/paddle-weight-advisor/',
  },
  {
    title: 'Overgrip Weight Adjustment',
    description: 'See how adding overgrips affects your paddle weight and grip size.',
    href: '/tools/overgrip-weight-adjustment/',
  },
  {
    title: 'Arm Comfort Recommendation Tool',
    description: 'Prioritize low vibration and strain reduction for arm comfort.',
    href: '/tools/arm-friendly-paddle-finder/',
  },
];

const faqs = [
  {
    question: 'How to measure grip size for a pickleball paddle?',
    answer: 'Measure from the middle lateral crease of your palm along your ring finger to its tip. The resulting length in inches (typically 4.0" to 4.5") corresponds directly to your target grip circumference.',
  },
  {
    question: 'How to determine pickleball paddle grip size if between sizes?',
    answer: 'If you fall between two standard 1/8" grip sizes, always choose the smaller size. You can easily build up a smaller grip with an overgrip (+1/16" build-up), whereas shrinking an oversized grip handle is virtually impossible.',
  },
  {
    question: 'What size grip for a pickleball paddle is standard for most players?',
    answer: 'The most common grip size is 4 1/4" (4.25 inches). Women and players under 5\'8" generally prefer 4.0" to 4.125" grips, while taller players or those with larger hands often use 4.375" to 4.5" grips.',
  },
  {
    question: 'How to choose pickleball paddle grip size for your playing style?',
    answer: 'A smaller grip provides greater wrist mobility, snap, and spin control—ideal for dinking and fast kitchen exchanges. A slightly larger grip provides paddle stability and reduces forearm strain, making it suitable for baseline drives and players with tennis elbow concerns.',
  },
  {
    question: 'What grip size for a pickleball paddle should I use if I wear an overgrip?',
    answer: 'Each standard overgrip layer adds approximately 1/16" (0.0625") to your total grip circumference. If your ideal circumference is 4 1/4" and you plan to add an overgrip, select a 4 1/8" paddle so it reaches 4 1/4" after wrapping.',
  },
  {
    question: 'How does a pickleball paddle grip size chart work?',
    answer: 'A pickleball paddle grip size chart maps hand measurements (in inches or cm) or player height/glove sizes to standard 1/8" grip increments (4", 4 1/8", 4 1/4", 4 3/8", 4 1/2"). Our calculator uses this exact mapping to give you instant, personalized results.',
  },
];
---

<CalculatorLayout
  title="Pickleball Grip Size Calculator & Chart | PaddleFitHub"
  description="Find your ideal paddle grip size using a hand measurement or height estimate. Includes a visual grip size chart and overgrip adjustment for all hand sizes."
  heading="Grip size calculator."
  intro="Measure your hand or use your height to find the right paddle grip size. Proper sizing prevents slipping, reduces wrist fatigue, and improves control on every shot."
  canonicalPath="/tools/grip-size-calculator/"
  relatedTools={relatedTools}
>
  <!-- 1. TOP SECTION: INTERACTIVE CALCULATOR TOOL -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12" id="grip-calculator">
    <!-- ── Left Column: Form Inputs ── -->
    <div>
      <h2 class="text-display-sm text-ink mb-6">1. Choose measurement method</h2>

      <!-- Method Selector Tabs -->
      <div class="flex rounded-md overflow-hidden border border-hairline mb-6">
        <button
          type="button"
          class="flex-1 py-3 px-2 sm:px-4 text-xs sm:text-body-sm-strong cursor-pointer transition-colors bg-ink text-on-primary text-center"
          id="method-direct-btn"
        >
          Direct Measurement
        </button>
        <button
          type="button"
          class="flex-1 py-3 px-2 sm:px-4 text-xs sm:text-body-sm-strong cursor-pointer transition-colors bg-canvas-soft text-body text-center border-l border-hairline"
          id="method-height-btn"
        >
          Height &amp; Glove Fallback
        </button>
      </div>

      <!-- METHOD A: DIRECT MEASUREMENT -->
      <div id="method-direct-panel" class="space-y-6">
        <div>
          <label class="text-body-sm-strong text-ink block mb-2">Measurement unit</label>
          <div class="flex rounded-sm overflow-hidden border border-hairline inline-flex">
            <button
              type="button"
              class="px-4 py-2 text-body-sm cursor-pointer transition-colors bg-ink text-on-primary"
              id="unit-inches"
            >
              Inches (in)
            </button>
            <button
              type="button"
              class="px-4 py-2 text-body-sm cursor-pointer transition-colors bg-canvas text-body border-l border-hairline"
              id="unit-cm"
            >
              Centimeters (cm)
            </button>
          </div>
        </div>

        <div>
          <label for="hand-measurement" class="text-body-sm-strong text-ink block mb-1">
            Palm crease to ring finger tip <span class="text-body-sm text-mute" id="unit-label">(inches)</span>
          </label>
          <p class="text-caption text-mute mb-2">
            Measure from the middle lateral crease of your palm along the ring finger to its tip.
          </p>
          <input
            type="number"
            id="hand-measurement"
            class="form-input"
            placeholder="e.g. 4.25"
            step="0.0625"
            min="3.0"
            max="6.0"
            autocomplete="off"
          />
          <p class="text-caption text-error mt-1 hidden" id="hand-error"></p>
        </div>

        <div>
          <label for="index-finger" class="text-body-sm-strong text-ink block mb-1">
            Index finger length <span class="text-body-sm text-mute">(optional refinement)</span>
          </label>
          <p class="text-caption text-mute mb-2">
            From base knuckle to tip. Used for refining edge cases.
          </p>
          <input
            type="number"
            id="index-finger"
            class="form-input"
            placeholder="e.g. 3.0"
            step="0.0625"
            min="1.5"
            max="5.0"
            autocomplete="off"
          />
          <p class="text-caption text-error mt-1 hidden" id="index-error"></p>
        </div>
      </div>

      <!-- METHOD B: HEIGHT & GLOVE FALLBACK -->
      <div id="method-height-panel" class="space-y-6 hidden">
        <div class="bg-canvas-soft rounded-md p-4 text-caption text-body">
          <strong>No ruler handy?</strong> Height and glove size correlate strongly with hand length and provide a solid starting point recommendation.
        </div>

        <div>
          <label for="player-height" class="text-body-sm-strong text-ink block mb-1">Your height</label>
          <select id="player-height" class="form-select">
            <option value="under-54">Under 5'4" (Under 163 cm)</option>
            <option value="54-58">5'4" – 5'8" (163 – 173 cm)</option>
            <option value="59-60" selected>5'9" – 6'0" (175 – 183 cm)</option>
            <option value="61-63">6'1" – 6'3" (185 – 191 cm)</option>
            <option value="over-63">Over 6'3" (Over 191 cm)</option>
          </select>
        </div>

        <div>
          <label for="glove-size" class="text-body-sm-strong text-ink block mb-1">Standard glove size</label>
          <select id="glove-size" class="form-select">
            <option value="small">Small (S)</option>
            <option value="medium" selected>Medium (M)</option>
            <option value="large">Large (L)</option>
            <option value="xlarge">Extra Large (XL)</option>
          </select>
        </div>
      </div>

      <!-- STEP 2: COMFORT & SETUP PREFERENCES -->
      <div class="mt-8 pt-6 border-t border-hairline">
        <h2 class="text-display-sm text-ink mb-4">2. Comfort &amp; setup options</h2>

        <div class="mb-6">
          <label class="text-body-sm-strong text-ink block mb-1">Grip feel preference</label>
          <div class="grid grid-cols-3 gap-2 mt-2">
            <label class="border border-hairline rounded-md p-3 text-center cursor-pointer transition-all hover:border-hairline-strong has-[:checked]:border-ink has-[:checked]:bg-canvas-soft">
              <input type="radio" name="comfort-pref" value="-0.125" class="sr-only" />
              <span class="text-body-sm-strong text-ink block">Tighter</span>
              <span class="text-caption text-mute block mt-0.5">−⅛" (More control)</span>
            </label>
            <label class="border border-hairline rounded-md p-3 text-center cursor-pointer transition-all hover:border-hairline-strong has-[:checked]:border-ink has-[:checked]:bg-canvas-soft">
              <input type="radio" name="comfort-pref" value="0" checked class="sr-only" />
              <span class="text-body-sm-strong text-ink block">Standard</span>
              <span class="text-caption text-mute block mt-0.5">Exact fit</span>
            </label>
            <label class="border border-hairline rounded-md p-3 text-center cursor-pointer transition-all hover:border-hairline-strong has-[:checked]:border-ink has-[:checked]:bg-canvas-soft">
              <input type="radio" name="comfort-pref" value="0.125" class="sr-only" />
              <span class="text-body-sm-strong text-ink block">Cushioned</span>
              <span class="text-caption text-mute block mt-0.5">+⅛" (More comfort)</span>
            </label>
          </div>
        </div>

        <div class="mb-5">
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" id="use-overgrip" class="mt-1 w-4 h-4 accent-ink rounded-xs" />
            <div>
              <span class="text-body-sm-strong text-ink block">I plan to use an overgrip (+1/16" build-up)</span>
              <span class="text-caption text-mute block mt-0.5">
                Overgrips add ~1/16" to 1/8" of thickness. We will recommend buying a paddle ⅛" smaller so the final wrapped grip matches your exact target.
              </span>
            </div>
          </label>
        </div>

        <div class="mb-6">
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" id="two-handed" class="mt-1 w-4 h-4 accent-ink rounded-xs" />
            <div>
              <span class="text-body-sm-strong text-ink block">Two-handed backhand player</span>
              <span class="text-caption text-mute block mt-0.5">
                Reduces target size by ¼" for easier hand-stacking on the handle.
              </span>
            </div>
          </label>
        </div>

        <div class="mb-6">
          <label for="current-issues" class="text-body-sm-strong text-ink block mb-1">
            Current grip issues <span class="text-body-sm text-mute">(optional)</span>
          </label>
          <select id="current-issues" class="form-select">
            <option value="none">No issues — feeling good</option>
            <option value="slipping">Paddle slips or twists during play</option>
            <option value="fatigue">Hand fatigue, cramping, or tight forearm</option>
            <option value="blisters">Blisters or hot spots on palm/fingers</option>
            <option value="wrist-pain">Wrist or elbow discomfort</option>
          </select>
        </div>
      </div>

      <button type="button" id="calculate-btn" class="btn-primary w-full sm:w-auto mt-2">
        Calculate Grip Size
      </button>
    </div>

    <!-- ── Right Column: Results Panel ── -->
    <div>
      <div id="results-placeholder" class="flex flex-col items-center justify-center h-full min-h-80 text-center p-8 border border-dashed border-hairline rounded-lg bg-canvas-soft/50">
        <div class="w-16 h-16 rounded-full bg-canvas-soft-2 flex items-center justify-center mb-4 text-mute">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 11V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0"/>
            <path d="M14 10V4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v2"/>
            <path d="M10 10.5V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v8"/>
            <path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 13"/>
          </svg>
        </div>
        <h3 class="text-body-md-strong text-ink mb-1">Awaiting your measurement</h3>
        <p class="text-body-sm text-mute max-w-xs">Enter your palm measurement or select your height to see your recommended grip size and rounding breakdown.</p>
      </div>

      <div id="results-panel" class="hidden space-y-6">
        <div class="bg-ink text-on-primary rounded-lg p-6 relative overflow-hidden">
          <div class="flex items-center justify-between mb-3">
            <span class="text-caption-mono text-hairline-strong uppercase tracking-wide">Recommended Grip Size</span>
            <span id="confidence-badge" class="px-2.5 py-1 rounded-full text-caption-mono bg-canvas/10 text-on-primary">
              High Confidence
            </span>
          </div>

          <div class="flex items-baseline gap-3 mb-2">
            <p class="text-display-xl text-on-primary font-semibold" id="result-size">4 ¼"</p>
            <span class="text-body-md text-hairline" id="result-fraction-label">(4.250 in)</span>
          </div>
          <p class="text-body-sm text-hairline-strong mb-4" id="result-metric">108.0 mm circumference</p>

          <div class="pt-4 border-t border-white/10 text-caption text-hairline space-y-1" id="result-breakdown">
          </div>
        </div>

        <div class="bg-canvas-soft rounded-lg p-5 border border-hairline">
          <div class="flex justify-between items-center mb-3">
            <h3 class="text-body-sm-strong text-ink">Standard Grip Spectrum</h3>
            <span class="text-caption-mono text-mute">Highlighting your fit</span>
          </div>
          <div class="space-y-2" id="size-chart">
          </div>
        </div>

        <div class="bg-canvas-soft rounded-lg p-5 border border-hairline space-y-3">
          <h3 class="text-body-sm-strong text-ink">Why this grip size was chosen</h3>
          <div class="text-body-sm text-body space-y-2" id="result-explanation">
          </div>
        </div>

        <div class="rounded-lg p-4 border" id="overgrip-note">
        </div>

        <div class="rounded-lg p-4 bg-warning-soft/40 border border-warning/30 hidden" id="issue-advice">
        </div>

        <div class="pt-4 border-t border-hairline">
          <h3 class="text-body-sm-strong text-ink mb-3">Recommended next steps</h3>
          <ul class="list-none p-0 m-0 space-y-2" id="next-steps">
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- 2. STEP-BY-STEP GUIDE SECTION -->
  <section class="mt-12 pt-8 border-t border-hairline">
    <h2 class="text-display-sm text-ink mb-4">How to Use This Tool</h2>
    <ol class="list-decimal pl-5 space-y-2 text-body-sm text-body">
      <li><strong>Select your measurement method:</strong> Choose <em>Direct Measurement</em> if you have a ruler or tape measure, or <em>Height &amp; Glove Fallback</em> if you don't.</li>
      <li><strong>Enter your hand length:</strong> Measure from the middle crease of your palm along your ring finger to its tip.</li>
      <li><strong>Optionally add index finger length:</strong> Providing your index finger length refines edge cases for high confidence.</li>
      <li><strong>Choose your grip feel preference:</strong> Select <em>Tighter (−⅛")</em> for control or <em>Cushioned (+⅛")</em> for extra padding.</li>
      <li><strong>Check setup modifiers:</strong> Check the overgrip box if you plan to wrap an overgrip, or two-handed backhand if applicable.</li>
      <li><strong>View your result:</strong> Click <em>Calculate Grip Size</em> to see your exact 1/8" fraction recommendation, visual spectrum placement, and overgrip guidance.</li>
    </ol>
  </section>

  <!-- 3. FORMULA & CALCULATION METHOD SECTION -->
  <section class="mt-8 pt-8 border-t border-hairline">
    <h2 class="text-display-sm text-ink mb-3">How the Result is Calculated</h2>
    <p class="text-body-sm text-body mb-4">
      Your hand measurement maps directly to required grip circumference. We apply any comfort preferences, subtract ⅛" if you plan to use an overgrip build-up, adjust for two-handed backhands, and mathematically round the result to the nearest standard commercial size (4", 4 ⅛", 4 ¼", 4 ⅜", 4 ½").
    </p>

    <div class="bg-canvas-soft p-4 rounded-md font-mono text-caption border border-hairline space-y-1">
      <div>Base Inches = Direct Palm-to-Finger Length (or Height Baseline + Glove Offset)</div>
      <div>Adjusted Target = Base + Comfort Preference (−0.125 to +0.125) − Overgrip Adj (0.125) − Backhand Adj (0.250)</div>
      <div>Final Recommendation = RoundToNearest0.125(Adjusted Target)</div>
    </div>
  </section>

  <!-- 4. REAL-WORLD EXAMPLES SECTION -->
  <section class="mt-8 pt-8 border-t border-hairline">
    <h2 class="text-display-sm text-ink mb-4">Real-World Examples</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-canvas-soft p-4 rounded-lg border border-hairline">
        <span class="text-caption-mono text-mute uppercase block mb-1">Example A: Standard Hand + Overgrip</span>
        <p class="text-body-sm text-ink font-medium mb-1">Palm measurement: 4.20 inches, plans overgrip</p>
        <p class="text-caption text-body">
          4.20" base − 0.125" (overgrip adjustment) = 4.075" → Rounds to <strong>4 ⅛" (4.125")</strong>. Buying a 4 ⅛" paddle and wrapping 1 overgrip (+1/16") brings the total wrapped grip to exactly 4 ¼".
        </p>
      </div>

      <div class="bg-canvas-soft p-4 rounded-lg border border-hairline">
        <span class="text-caption-mono text-mute uppercase block mb-1">Example B: Cushioned Comfort Preference</span>
        <p class="text-body-sm text-ink font-medium mb-1">Palm measurement: 4.40 inches, prefers cushioned feel</p>
        <p class="text-caption text-body">
          4.40" base + 0.125" (cushioned preference) = 4.525" → Rounds to <strong>4 ½" (4.500")</strong>. Sizing up ⅛" provides extra palm padding and reduces forearm tension.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FAQSection title="Pickleball Grip Size FAQs" faqs={faqs} />
</CalculatorLayout>

<script>
  // Safe client-side logic
  const GRIP_SIZES = [
    { size: '4"', decimal: 4.0, mm: 101.6, fraction: '4' },
    { size: '4 ⅛"', decimal: 4.125, mm: 104.8, fraction: '4 ⅛' },
    { size: '4 ¼"', decimal: 4.25, mm: 108.0, fraction: '4 ¼' },
    { size: '4 ⅜"', decimal: 4.375, mm: 111.1, fraction: '4 ⅜' },
    { size: '4 ½"', decimal: 4.5, mm: 114.3, fraction: '4 ½' },
    { size: '4 ⅝"', decimal: 4.625, mm: 117.5, fraction: '4 ⅝' },
  ];

  const STORAGE_KEY = 'paddlefit_grip_calculator_state';

  // DOM Elements
  const methodDirectBtn = document.getElementById('method-direct-btn') as HTMLButtonElement;
  const methodHeightBtn = document.getElementById('method-height-btn') as HTMLButtonElement;
  const methodDirectPanel = document.getElementById('method-direct-panel') as HTMLDivElement;
  const methodHeightPanel = document.getElementById('method-height-panel') as HTMLDivElement;

  const unitInches = document.getElementById('unit-inches') as HTMLButtonElement;
  const unitCm = document.getElementById('unit-cm') as HTMLButtonElement;
  const unitLabel = document.getElementById('unit-label') as HTMLSpanElement;

  const handInput = document.getElementById('hand-measurement') as HTMLInputElement;
  const handError = document.getElementById('hand-error') as HTMLParagraphElement;
  const indexInput = document.getElementById('index-finger') as HTMLInputElement;
  const indexError = document.getElementById('index-error') as HTMLParagraphElement;

  const playerHeightSelect = document.getElementById('player-height') as HTMLSelectElement;
  const gloveSizeSelect = document.getElementById('glove-size') as HTMLSelectElement;

  const useOvergrip = document.getElementById('use-overgrip') as HTMLInputElement;
  const twoHanded = document.getElementById('two-handed') as HTMLInputElement;
  const issueSelect = document.getElementById('current-issues') as HTMLSelectElement;
  const calculateBtn = document.getElementById('calculate-btn') as HTMLButtonElement;

  const resultsPlaceholder = document.getElementById('results-placeholder') as HTMLDivElement;
  const resultsPanel = document.getElementById('results-panel') as HTMLDivElement;
  const confidenceBadge = document.getElementById('confidence-badge') as HTMLSpanElement;

  const resultSize = document.getElementById('result-size') as HTMLParagraphElement;
  const resultFractionLabel = document.getElementById('result-fraction-label') as HTMLSpanElement;
  const resultMetric = document.getElementById('result-metric') as HTMLParagraphElement;
  const resultBreakdown = document.getElementById('result-breakdown') as HTMLDivElement;
  const sizeChart = document.getElementById('size-chart') as HTMLDivElement;
  const resultExplanation = document.getElementById('result-explanation') as HTMLDivElement;
  const overgripNote = document.getElementById('overgrip-note') as HTMLDivElement;
  const issueAdvice = document.getElementById('issue-advice') as HTMLDivElement;
  const nextSteps = document.getElementById('next-steps') as HTMLUListElement;

  let currentMethod: 'direct' | 'height' = 'direct';
  let isMetric = false;

  function setMethod(method: 'direct' | 'height') {
    currentMethod = method;
    if (method === 'direct') {
      methodDirectBtn.classList.add('bg-ink', 'text-on-primary');
      methodDirectBtn.classList.remove('bg-canvas-soft', 'text-body');
      methodHeightBtn.classList.remove('bg-ink', 'text-on-primary');
      methodHeightBtn.classList.add('bg-canvas-soft', 'text-body');
      methodDirectPanel.classList.remove('hidden');
      methodHeightPanel.classList.add('hidden');
    } else {
      methodHeightBtn.classList.add('bg-ink', 'text-on-primary');
      methodHeightBtn.classList.remove('bg-canvas-soft', 'text-body');
      methodDirectBtn.classList.remove('bg-ink', 'text-on-primary');
      methodDirectBtn.classList.add('bg-canvas-soft', 'text-body');
      methodHeightPanel.classList.remove('hidden');
      methodDirectPanel.classList.add('hidden');
    }
  }

  function setUnit(metric: boolean) {
    isMetric = metric;
    if (metric) {
      unitCm.classList.add('bg-ink', 'text-on-primary');
      unitCm.classList.remove('bg-canvas', 'text-body');
      unitInches.classList.remove('bg-ink', 'text-on-primary');
      unitInches.classList.add('bg-canvas', 'text-body');
      unitLabel.textContent = '(cm)';
      handInput.placeholder = 'e.g. 10.8';
      indexInput.placeholder = 'e.g. 7.6';
      handInput.step = '0.1';
      indexInput.step = '0.1';
    } else {
      unitInches.classList.add('bg-ink', 'text-on-primary');
      unitInches.classList.remove('bg-canvas', 'text-body');
      unitCm.classList.remove('bg-ink', 'text-on-primary');
      unitCm.classList.add('bg-canvas', 'text-body');
      unitLabel.textContent = '(inches)';
      handInput.placeholder = 'e.g. 4.25';
      indexInput.placeholder = 'e.g. 3.0';
      handInput.step = '0.0625';
      indexInput.step = '0.0625';
    }
  }

  function roundTo8th(val: number): number {
    return Math.round(val * 8) / 8;
  }

  function formatFractionStr(num: number): string {
    const whole = Math.floor(num);
    const frac = Math.round((num - whole) * 8);
    if (frac === 0) return `${whole}"`;
    const fracMap: Record<number, string> = { 1: '⅛', 2: '¼', 3: '⅜', 4: '½', 5: '⅝', 6: '¾', 7: '⅞' };
    return `${whole} ${fracMap[frac] || ''}"`;
  }

  function validateDirect(): boolean {
    let valid = true;
    handError.classList.add('hidden');
    indexError.classList.add('hidden');

    const rawHand = parseFloat(handInput.value);
    if (isNaN(rawHand) || handInput.value.trim() === '') {
      handError.textContent = 'Please enter your palm-to-finger measurement.';
      handError.classList.remove('hidden');
      valid = false;
    } else {
      const inches = isMetric ? rawHand / 2.54 : rawHand;
      if (inches < 3.0 || inches > 6.0) {
        handError.textContent = `Measurement (${rawHand}${isMetric ? 'cm' : '"'}) seems out of range (typical: 3.5" to 5.0"). Please re-check.`;
        handError.classList.remove('hidden');
        valid = false;
      }
    }

    const rawIndex = parseFloat(indexInput.value);
    if (!isNaN(rawIndex) && indexInput.value.trim() !== '') {
      const idxInches = isMetric ? rawIndex / 2.54 : rawIndex;
      if (idxInches < 1.5 || idxInches > 5.0) {
        indexError.textContent = 'Index finger length seems out of expected range.';
        indexError.classList.remove('hidden');
        valid = false;
      }
    }

    return valid;
  }

  function calculate() {
    let baseInches = 4.25;
    let confidenceText = 'High Confidence';
    let confidenceClass = 'bg-canvas/10 text-on-primary border border-white/20';
    let isFallback = false;

    if (currentMethod === 'direct') {
      if (!validateDirect()) return;
      const rawHand = parseFloat(handInput.value);
      baseInches = isMetric ? rawHand / 2.54 : rawHand;

      const rawIndex = parseFloat(indexInput.value);
      if (!isNaN(rawIndex) && indexInput.value.trim() !== '') {
        confidenceText = 'High Confidence (Direct + Index Refined)';
      } else {
        confidenceText = 'High Confidence (Direct Measurement)';
      }
    } else {
      isFallback = true;
      const heightVal = playerHeightSelect.value;
      const gloveVal = gloveSizeSelect.value;

      const heightMap: Record<string, number> = {
        'under-54': 4.0,
        '54-58': 4.125,
        '59-60': 4.25,
        '61-63': 4.375,
        'over-63': 4.5,
      };
      const gloveMap: Record<string, number> = {
        small: -0.125,
        medium: 0,
        large: 0.125,
        xlarge: 0.25,
      };

      baseInches = (heightMap[heightVal] || 4.25) + (gloveMap[gloveVal] || 0);
      confidenceText = 'Best Starting Point (Height Fallback)';
      confidenceClass = 'bg-canvas/10 text-on-primary border border-white/20';
    }

    const checkedComfort = document.querySelector('input[name="comfort-pref"]:checked') as HTMLInputElement;
    const comfortVal = checkedComfort ? parseFloat(checkedComfort.value) : 0;

    let adjustedInches = baseInches + comfortVal;

    if (useOvergrip.checked) {
      adjustedInches -= 0.125;
    }

    if (twoHanded.checked) {
      adjustedInches -= 0.25;
    }

    const roundedTarget = roundTo8th(adjustedInches);
    const clampedTarget = Math.min(Math.max(roundedTarget, GRIP_SIZES[0].decimal), GRIP_SIZES[GRIP_SIZES.length - 1].decimal);

    let bestIdx = 0;
    let minDiff = Infinity;
    GRIP_SIZES.forEach((gs, idx) => {
      const diff = Math.abs(gs.decimal - clampedTarget);
      if (diff < minDiff) {
        minDiff = diff;
        bestIdx = idx;
      }
    });

    const rec = GRIP_SIZES[bestIdx];

    resultsPlaceholder.classList.add('hidden');
    resultsPanel.classList.remove('hidden');

    confidenceBadge.textContent = confidenceText;
    confidenceBadge.className = `px-2.5 py-1 rounded-full text-caption-mono ${confidenceClass}`;

    resultSize.textContent = rec.size;
    resultFractionLabel.textContent = `(${rec.decimal.toFixed(3)} in)`;
    resultMetric.textContent = `${rec.mm.toFixed(1)} mm grip circumference`;

    const breakdownItems: string[] = [];
    if (!isFallback) {
      const rawHandVal = parseFloat(handInput.value);
      breakdownItems.push(`• Base measurement: ${rawHandVal}${isMetric ? ' cm' : '"'} (${baseInches.toFixed(3)}")`);
    } else {
      breakdownItems.push(`• Estimated baseline from height/glove: ${baseInches.toFixed(3)}"`);
    }

    if (comfortVal !== 0) {
      const label = comfortVal > 0 ? '+0.125" (Cushioned comfort)' : '-0.125" (Tighter control)';
      breakdownItems.push(`• Preference adjustment: ${label}`);
    }

    if (useOvergrip.checked) {
      breakdownItems.push(`• Overgrip adjustment: −0.125" (Sized down for overgrip build-up)`);
    }

    if (twoHanded.checked) {
      breakdownItems.push(`• Two-handed backhand adjustment: −0.250"`);
    }

    breakdownItems.push(`• Final target (rounded to nearest ⅛"): ${formatFractionStr(clampedTarget)} (${clampedTarget.toFixed(3)}") → ${rec.size}`);

    resultBreakdown.innerHTML = breakdownItems.map(item => `<div>${item}</div>`).join('');

    sizeChart.innerHTML = GRIP_SIZES.map((gs, i) => {
      const isSelected = i === bestIdx;
      const barPct = 18 + ((gs.decimal - 4.0) / 0.625) * 82;
      return `
        <div class="p-2.5 rounded-md transition-all ${isSelected ? 'bg-canvas ring-1 ring-hairline shadow-level-1' : ''}">
          <div class="flex items-center justify-between text-caption mb-1.5">
            <div class="flex items-center gap-2">
              <span class="${isSelected ? 'font-semibold text-ink text-body-sm' : 'text-mute font-medium'}">${gs.size}</span>
              <span class="text-caption-mono ${isSelected ? 'text-body font-medium' : 'text-mute'}">(${gs.mm.toFixed(1)} mm)</span>
            </div>
            ${isSelected ? '<span class="px-2 py-0.5 rounded-full bg-ink text-on-primary text-[10px] font-mono font-medium tracking-tight uppercase shrink-0">Recommended</span>' : ''}
          </div>
          <div class="h-2.5 bg-canvas-soft-2 rounded-full overflow-hidden">
            <div
              class="h-full rounded-full transition-all duration-300 ${isSelected ? 'bg-ink' : 'bg-hairline-strong/30'}"
              style="width: ${barPct.toFixed(1)}%"
            ></div>
          </div>
        </div>
      `;
    }).join('');

    const explanationText: string[] = [];
    if (!isFallback) {
      explanationText.push(`Your measured hand length maps directly to a <strong>${formatFractionStr(roundTo8th(baseInches))}</strong> baseline circumference.`);
    } else {
      explanationText.push(`Based on your height and glove size, a baseline of <strong>${formatFractionStr(roundTo8th(baseInches))}</strong> provides an ergonomic starting fit.`);
    }

    if (useOvergrip.checked) {
      explanationText.push(`Because you plan to wrap an overgrip (+1/16" build-up), we recommended buying a <strong>${rec.size}</strong> paddle. Once wrapped, the total grip will expand to your target size.`);
    }

    if (twoHanded.checked) {
      explanationText.push(`The ¼" reduction for two-handed backhands provides extra room on the handle for your non-dominant hand.`);
    }

    explanationText.push(`Matching your grip size prevents over-squeezing, which reduces forearm strain and improves wrist mobility during dinks and resets.`);

    resultExplanation.innerHTML = explanationText.map(t => `<p>${t}</p>`).join('');

    if (useOvergrip.checked) {
      overgripNote.className = 'rounded-lg p-4 bg-cyan-soft/30 border border-cyan-deep/20';
      overgripNote.innerHTML = `
        <p class="text-body-sm-strong text-ink mb-1">✓ Sized for overgrip build-up</p>
        <p class="text-caption text-body">Buying a paddle in <strong>${rec.size}</strong> and adding 1 standard overgrip (0.6 mm) brings your effective grip to ${formatFractionStr(clampedTarget + 0.125)}.</p>
      `;
    } else {
      overgripNote.className = 'rounded-lg p-4 bg-canvas-soft border border-hairline';
      overgripNote.innerHTML = `
        <p class="text-body-sm-strong text-ink mb-1">Using standard replacement grip</p>
        <p class="text-caption text-body">If you decide to add an overgrip later, your grip will expand by ~⅛". If you feel between sizes, opt for ${rec.size} and add an overgrip to fine-tune.</p>
      `;
    }

    const issue = issueSelect.value;
    if (issue !== 'none') {
      issueAdvice.classList.remove('hidden');
      const issueMsgs: Record<string, string> = {
        slipping: 'Slipping often indicates a grip that is too small or worn out. Consider a tackier perforated overgrip or sizing up ⅛".',
        fatigue: 'Hand fatigue and forearm cramping usually result from a grip that is too small, forcing you to death-grip the handle.',
        blisters: 'Blisters occur when the grip shifts in your palm. A correct fit eliminates excess friction during off-center hits.',
        'wrist-pain': 'Wrist or elbow discomfort is aggravated by excessive torque. Ensure your grip size lets your fingers rest naturally without overlapping tightly.',
      };
      issueAdvice.innerHTML = `
        <p class="text-body-sm-strong text-ink mb-1">Grip issue advisory</p>
        <p class="text-caption text-body">${issueMsgs[issue] || ''}</p>
      `;
    } else {
      issueAdvice.classList.add('hidden');
    }

    nextSteps.innerHTML = `
      <li>
        <a href="/tools/overgrip-weight-adjustment/" class="flex items-center gap-2 text-body-sm text-link hover:underline">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7H11M11 7L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          See how overgrips adjust paddle weight and balance
        </a>
      </li>
      <li>
        <a href="/tools/paddle-weight-advisor/" class="flex items-center gap-2 text-body-sm text-link hover:underline">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7H11M11 7L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Find the right paddle weight range for your play style
        </a>
      </li>
    `;

    saveState();
  }

  function saveState() {
    try {
      const data = {
        method: currentMethod,
        isMetric,
        handMeasurement: handInput.value,
        indexFinger: indexInput.value,
        playerHeight: playerHeightSelect.value,
        gloveSize: gloveSizeSelect.value,
        comfortPref: (document.querySelector('input[name="comfort-pref"]:checked') as HTMLInputElement)?.value || '0',
        useOvergrip: useOvergrip.checked,
        twoHanded: twoHanded.checked,
        currentIssues: issueSelect.value,
      };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    } catch {}
  }

  function loadState() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const data = JSON.parse(raw);

      if (data.method) setMethod(data.method);
      if (data.isMetric) setUnit(true);
      if (data.handMeasurement) handInput.value = data.handMeasurement;
      if (data.indexFinger) indexInput.value = data.indexFinger;
      if (data.playerHeight) playerHeightSelect.value = data.playerHeight;
      if (data.gloveSize) gloveSizeSelect.value = data.gloveSize;
      if (data.useOvergrip) useOvergrip.checked = data.useOvergrip;
      if (data.twoHanded) twoHanded.checked = data.twoHanded;
      if (data.currentIssues) issueSelect.value = data.currentIssues;

      if (data.comfortPref) {
        const radio = document.querySelector(`input[name="comfort-pref"][value="${data.comfortPref}"]`) as HTMLInputElement;
        if (radio) radio.checked = true;
      }
    } catch {}
  }

  methodDirectBtn.addEventListener('click', () => setMethod('direct'));
  methodHeightBtn.addEventListener('click', () => setMethod('height'));

  unitInches.addEventListener('click', () => setUnit(false));
  unitCm.addEventListener('click', () => setUnit(true));

  calculateBtn.addEventListener('click', calculate);

  handInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') calculate();
  });

  loadState();
</script>
