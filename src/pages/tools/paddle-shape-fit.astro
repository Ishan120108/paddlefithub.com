---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import FAQSection from '../../components/FAQSection.astro';

const relatedTools = [
  {
    title: 'Grip Size Calculator',
    description: 'Find your ideal grip size using a hand measurement.',
    href: '/tools/grip-size-calculator/',
  },
  {
    title: 'Paddle Weight Advisor',
    description: 'Get the right weight for your play style.',
    href: '/tools/paddle-weight-advisor/',
  },
  {
    title: 'Core Thickness Advisor',
    description: 'Understand 14 mm, 16 mm, and 20 mm core tradeoffs.',
    href: '/tools/core-thickness-advisor/',
  },
];

const faqs = [
  {
    question: 'What are the main pickleball paddle shapes?',
    answer: 'Under USA Pickleball regulations, the combined length and width cannot exceed 24 inches. The three main shapes are Standard Wide Face (16" × 8"), Hybrid (16.25" × 7.8"), and Elongated (16.5" × 7.5").',
  },
  {
    question: 'Which paddle shape is best for aggressive play?',
    answer: 'Elongated paddles (16.5" long) are best for aggressive play. Their extra length creates leverage for higher head speed, leading to harder baseline drives, aggressive overheads, and extra court coverage at the kitchen line.',
  },
  {
    question: 'What shape pickleball paddle is best for all-around play?',
    answer: 'Hybrid shapes (16.25" × 7.8") offer the best all-around performance. They provide extra reach over standard paddles while maintaining a wide sweet spot and fast kitchen maneuverability.',
  },
  {
    question: 'How to use a pickleball paddle shape guide to find your fit?',
    answer: 'A paddle shape guide evaluates your priorities: if you prioritize sweet spot size and kitchen fast hands, choose Standard; if you prioritize power and reach, choose Elongated; for a balance of both, select Hybrid.',
  },
  {
    question: 'What is the best pickleball paddle shape for beginners?',
    answer: 'Standard Wide Face (16" × 8") is the best shape for beginners because it offers the largest sweet spot and highest forgiveness on off-center hits.',
  },
];
---

<CalculatorLayout
  title="Pickleball Paddle Shape Guide | PaddleFitHub"
  description="Compare Standard, Hybrid, and Elongated paddle shapes. Get a scored breakdown, visual comparison, and top-ranked fit based on your play style."
  heading="Paddle shape fit."
  intro="Standard, Hybrid, or Elongated — each shape trades off sweet spot size, reach, and maneuverability differently. See which one matches your game."
  canonicalPath="/tools/paddle-shape-fit/"
  relatedTools={relatedTools}
>
  <!-- 1. TOP SECTION: INTERACTIVE CALCULATOR TOOL -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12" id="shape-calculator">
    <!-- ── Left Column: Form Inputs ── -->
    <div>
      <h2 class="text-display-sm text-ink mb-6">1. Your play format &amp; court position</h2>

      <div class="mb-6">
        <label for="game-style" class="text-body-sm-strong text-ink block mb-1">Primary game format</label>
        <select id="game-style" class="form-select">
          <option value="doubles" selected>Doubles (Prioritizes fast net reactions &amp; sweet spot)</option>
          <option value="singles">Singles (Prioritizes reach &amp; drive leverage)</option>
          <option value="mixed">Both Doubles &amp; Singles (Versatile all-court)</option>
        </select>
      </div>

      <div class="mb-6">
        <label for="court-position" class="text-body-sm-strong text-ink block mb-1">Preferred court position</label>
        <select id="court-position" class="form-select">
          <option value="kitchen" selected>Kitchen Line / Net Player (Speed &amp; soft dinking)</option>
          <option value="transitional">Transitional / All-Court (Third shot drops &amp; drives)</option>
          <option value="baseline">Baseline / Power Attacker (Smashes &amp; heavy drives)</option>
        </select>
      </div>

      <div class="mb-6">
        <label for="swing-style" class="text-body-sm-strong text-ink block mb-1">Swing mechanics</label>
        <select id="swing-style" class="form-select">
          <option value="compact">Compact / Wristy swings (Quick reaction focus)</option>
          <option value="moderate" selected>Moderate swing length (Balanced timing)</option>
          <option value="full">Full swings with follow-through (Tennis-style loop)</option>
        </select>
      </div>

      <h2 class="text-display-sm text-ink mb-4 pt-4 border-t border-hairline">2. Priority weighting (1 to 5)</h2>
      <p class="text-caption text-mute mb-4">Rate how important each factor is to your game:</p>

      <div class="space-y-4 mb-6">
        <div>
          <div class="flex justify-between text-body-sm mb-1">
            <span class="text-ink font-medium">Power &amp; Drive Leverage</span>
            <span class="text-mute font-mono" id="power-val">3</span>
          </div>
          <input type="range" id="power-priority" min="1" max="5" value="3" class="w-full accent-ink cursor-pointer" />
        </div>
        <div>
          <div class="flex justify-between text-body-sm mb-1">
            <span class="text-ink font-medium">Control &amp; Sweet Spot Size</span>
            <span class="text-mute font-mono" id="control-val">4</span>
          </div>
          <input type="range" id="control-priority" min="1" max="5" value="4" class="w-full accent-ink cursor-pointer" />
        </div>
        <div>
          <div class="flex justify-between text-body-sm mb-1">
            <span class="text-ink font-medium">Extra Reach (Overheads &amp; Wide Balls)</span>
            <span class="text-mute font-mono" id="reach-val">3</span>
          </div>
          <input type="range" id="reach-priority" min="1" max="5" value="3" class="w-full accent-ink cursor-pointer" />
        </div>
        <div>
          <div class="flex justify-between text-body-sm mb-1">
            <span class="text-ink font-medium">Net Maneuverability &amp; Hand Speed</span>
            <span class="text-mute font-mono" id="maneuver-val">4</span>
          </div>
          <input type="range" id="maneuver-priority" min="1" max="5" value="4" class="w-full accent-ink cursor-pointer" />
        </div>
      </div>

      <button type="button" id="calc-shape-btn" class="btn-primary w-full sm:w-auto">
        Calculate Shape Match
      </button>
    </div>

    <!-- ── Right Column: Results Panel ── -->
    <div>
      <div id="shape-placeholder" class="flex flex-col items-center justify-center h-full min-h-80 text-center p-8 border border-dashed border-hairline rounded-lg bg-canvas-soft/50">
        <div class="w-16 h-16 rounded-full bg-canvas-soft-2 flex items-center justify-center mb-4 text-mute">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="12" rx="2"/><path d="M12 4v12"/>
          </svg>
        </div>
        <h3 class="text-body-md-strong text-ink mb-1">Compare paddle shapes</h3>
        <p class="text-body-sm text-mute max-w-xs">Select your game preferences to see ranked recommendations for Standard, Hybrid, and Elongated shapes.</p>
      </div>

      <div id="shape-results" class="hidden space-y-6">
        <div id="shape-top2" class="space-y-4"></div>

        <div class="bg-canvas-soft rounded-lg p-5 border border-hairline">
          <h3 class="text-body-sm-strong text-ink mb-3">Shape Geometry Comparison</h3>
          <div class="grid grid-cols-3 gap-2 text-center text-caption">
            <div class="bg-canvas p-3 rounded border border-hairline">
              <span class="text-body-sm-strong text-ink block">Standard</span>
              <span class="text-mute block mt-1">16" × 8"</span>
              <span class="text-caption-mono text-cyan-deep block mt-1">Max Sweet Spot</span>
            </div>
            <div class="bg-canvas p-3 rounded border border-hairline">
              <span class="text-body-sm-strong text-ink block">Hybrid</span>
              <span class="text-mute block mt-1">16.25" × 7.8"</span>
              <span class="text-caption-mono text-cyan-deep block mt-1">Balanced Fit</span>
            </div>
            <div class="bg-canvas p-3 rounded border border-hairline">
              <span class="text-body-sm-strong text-ink block">Elongated</span>
              <span class="text-mute block mt-1">16.5" × 7.5"</span>
              <span class="text-caption-mono text-cyan-deep block mt-1">Max Reach</span>
            </div>
          </div>
        </div>

        <div id="shape-explanation" class="bg-canvas-soft rounded-lg p-5 border border-hairline space-y-2"></div>

        <div id="shape-comparison-table" class="overflow-x-auto"></div>

        <p class="text-caption text-mute italic bg-canvas-soft p-3 rounded border border-hairline">
          💡 <strong>Preference Note:</strong> Paddle shape fit is highly preference-driven. If the top 2 matches are within 10% of each other, demoing both shapes on-court is strongly recommended.
        </p>

        <div class="pt-4 border-t border-hairline">
          <h3 class="text-body-sm-strong text-ink mb-3">Recommended next steps</h3>
          <div class="space-y-2">
            <a href="/tools/paddle-weight-advisor/" class="flex items-center gap-2 text-body-sm text-link hover:underline">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7H11M11 7L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Find the optimal weight for your chosen shape
            </a>
            <a href="/tools/grip-size-calculator/" class="flex items-center gap-2 text-body-sm text-link hover:underline">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7H11M11 7L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Calculate your exact grip size fit
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 2. STEP-BY-STEP GUIDE SECTION -->
  <section class="mt-12 pt-8 border-t border-hairline">
    <h2 class="text-display-sm text-ink mb-4">How to Use This Tool</h2>
    <ol class="list-decimal pl-5 space-y-2 text-body-sm text-body">
      <li><strong>Select game format:</strong> Choose Doubles (net reaction focus), Singles (reach focus), or Mixed.</li>
      <li><strong>Choose court position:</strong> Indicate if you spend most time at the Kitchen Line, All-Court, or Baseline.</li>
      <li><strong>Select swing mechanics:</strong> Choose compact wristy swings vs full loop swings.</li>
      <li><strong>Adjust priorities (1–5):</strong> Rate Power, Control/Sweet Spot, Extra Reach, and Net Maneuverability.</li>
      <li><strong>Click Calculate Shape Match:</strong> Compare match percentages for #1 Primary and #2 Secondary shapes.</li>
    </ol>
  </section>

  <!-- 3. FORMULA & CALCULATION METHOD SECTION -->
  <section class="mt-8 pt-8 border-t border-hairline">
    <h2 class="text-display-sm text-ink mb-3">How the Result is Calculated</h2>
    <p class="text-body-sm text-body mb-4">
      Every paddle shape trades sweet spot width for overall reach. Standard shapes (16"×8") offer maximum sweet spot width and net speed. Elongated shapes (16.5"×7.5") maximize reach and drive leverage. Hybrid shapes (16.25"×7.8") balance both. We calculate a weighted score across your priorities, game format, and swing mechanics.
    </p>

    <div class="bg-canvas-soft p-4 rounded-md font-mono text-caption border border-hairline space-y-1">
      <div>Shape Score = 2 × Σ(Priority_i × ShapeScore_i) + FormatBonus + PositionBonus + SwingBonus</div>
      <div>Match Percentage = (Shape Score / Top Shape Score) × 100</div>
    </div>
  </section>

  <!-- 4. REAL-WORLD EXAMPLES SECTION -->
  <section class="mt-8 pt-8 border-t border-hairline">
    <h2 class="text-display-sm text-ink mb-4">Real-World Examples</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-canvas-soft p-4 rounded-lg border border-hairline">
        <span class="text-caption-mono text-mute uppercase block mb-1">Example A: Doubles Net Player</span>
        <p class="text-body-sm text-ink font-medium mb-1">Doubles, Kitchen player, rates Control &amp; Maneuverability 5/5</p>
        <p class="text-caption text-body">
          <strong>Standard Shape (16"×8")</strong> ranks #1 with 98% match due to its 8.0" wide face providing maximum dink sweet spot and fast net reactions.
        </p>
      </div>

      <div class="bg-canvas-soft p-4 rounded-lg border border-hairline">
        <span class="text-caption-mono text-mute uppercase block mb-1">Example B: Singles Baseline Attacker</span>
        <p class="text-body-sm text-ink font-medium mb-1">Singles, Baseline position, rates Reach &amp; Power 5/5</p>
        <p class="text-caption text-body">
          <strong>Elongated Shape (16.5"×7.5")</strong> ranks #1 with 100% match due to maximum reach on wide passing shots and extra drive leverage.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FAQSection title="Pickleball Paddle Shape FAQs" faqs={faqs} />
</CalculatorLayout>

<script>
  const STORAGE_KEY = 'paddlefit_shape_fit_state';

  interface ShapeProfile {
    id: string;
    name: string;
    dimensions: string;
    description: string;
    scores: { power: number; control: number; reach: number; maneuver: number };
    pros: string[];
    cons: string[];
  }

  const shapes: ShapeProfile[] = [
    {
      id: 'standard',
      name: 'Standard Shape',
      dimensions: '16" × 8" (8.0" wide face)',
      description: 'The widest paddle surface providing the maximum sweet spot and fastest hand speed at the kitchen line.',
      scores: { power: 3, control: 5, reach: 2, maneuver: 5 },
      pros: ['Largest, most forgiving sweet spot', 'Quickest net reaction speed', 'Easiest dink control', 'Ideal for doubles players'],
      cons: ['Shorter reach on wide balls', 'Lower natural drive leverage'],
    },
    {
      id: 'hybrid',
      name: 'Hybrid Shape',
      dimensions: '16.25" × 7.8" (Slightly extended)',
      description: 'The most popular modern shape — adds 0.25" of reach while preserving 90% of a standard sweet spot.',
      scores: { power: 4, control: 4, reach: 3.5, maneuver: 4 },
      pros: ['Excellent balance of reach and forgiveness', 'Versatile across all court positions', 'Smooth transition for all levels'],
      cons: ['Jack-of-all-trades feel'],
    },
    {
      id: 'elongated',
      name: 'Elongated Shape',
      dimensions: '16.5" × 7.5" (Narrow extended face)',
      description: 'Maximum reach and whip leverage for high-powered groundstrokes, drives, and singles coverage.',
      scores: { power: 5, control: 2.5, reach: 5, maneuver: 2.5 },
      pros: ['Maximum reach for overheads & wide passes', 'Highest pop and drive whip leverage', 'Excellent for Singles'],
      cons: ['Narrower sweet spot', 'Slower net hand speed', 'Steeper learning curve'],
    },
  ];

  const gameStyleSelect = document.getElementById('game-style') as HTMLSelectElement;
  const courtPosSelect = document.getElementById('court-position') as HTMLSelectElement;
  const swingStyleSelect = document.getElementById('swing-style') as HTMLSelectElement;

  const powerPriInput = document.getElementById('power-priority') as HTMLInputElement;
  const controlPriInput = document.getElementById('control-priority') as HTMLInputElement;
  const reachPriInput = document.getElementById('reach-priority') as HTMLInputElement;
  const maneuverPriInput = document.getElementById('maneuver-priority') as HTMLInputElement;

  const powerValLabel = document.getElementById('power-val') as HTMLSpanElement;
  const controlValLabel = document.getElementById('control-val') as HTMLSpanElement;
  const reachValLabel = document.getElementById('reach-val') as HTMLSpanElement;
  const maneuverValLabel = document.getElementById('maneuver-val') as HTMLSpanElement;

  const calcBtn = document.getElementById('calc-shape-btn') as HTMLButtonElement;
  const placeholder = document.getElementById('shape-placeholder') as HTMLDivElement;
  const results = document.getElementById('shape-results') as HTMLDivElement;

  const top2Container = document.getElementById('shape-top2') as HTMLDivElement;
  const explanationEl = document.getElementById('shape-explanation') as HTMLDivElement;
  const comparisonEl = document.getElementById('shape-comparison-table') as HTMLDivElement;

  function updateSliderLabels() {
    powerValLabel.textContent = powerPriInput.value;
    controlValLabel.textContent = controlPriInput.value;
    reachValLabel.textContent = reachPriInput.value;
    maneuverValLabel.textContent = maneuverPriInput.value;
  }

  [powerPriInput, controlPriInput, reachPriInput, maneuverPriInput].forEach(input => {
    input.addEventListener('input', updateSliderLabels);
  });

  function calculate() {
    const gameStyle = gameStyleSelect.value;
    const courtPos = courtPosSelect.value;
    const swingStyle = swingStyleSelect.value;

    const powerPri = parseInt(powerPriInput.value);
    const controlPri = parseInt(controlPriInput.value);
    const reachPri = parseInt(reachPriInput.value);
    const maneuverPri = parseInt(maneuverPriInput.value);

    const scored = shapes.map(shape => {
      let score = 0;

      score += powerPri * shape.scores.power * 2.0;
      score += controlPri * shape.scores.control * 2.0;
      score += reachPri * shape.scores.reach * 2.0;
      score += maneuverPri * shape.scores.maneuver * 2.0;

      if (gameStyle === 'singles') {
        score += shape.scores.reach * 3.5;
        score += shape.scores.power * 2.0;
      } else if (gameStyle === 'doubles') {
        score += shape.scores.maneuver * 3.5;
        score += shape.scores.control * 2.5;
      } else {
        score += shape.scores.reach * 1.5;
        score += shape.scores.maneuver * 1.5;
      }

      if (courtPos === 'kitchen') {
        score += shape.scores.maneuver * 3.0;
        score += shape.scores.control * 2.0;
      } else if (courtPos === 'baseline') {
        score += shape.scores.reach * 3.0;
        score += shape.scores.power * 2.0;
      } else {
        score += shape.scores.control * 1.5;
        score += shape.scores.reach * 1.5;
      }

      if (swingStyle === 'compact') {
        score += shape.scores.maneuver * 2.0;
      } else if (swingStyle === 'full') {
        score += shape.scores.power * 2.0;
        score += shape.scores.reach * 2.0;
      }

      return { ...shape, totalScore: Math.round(score) };
    });

    scored.sort((a, b) => b.totalScore - a.totalScore);
    const topScore = scored[0].totalScore;

    placeholder.classList.add('hidden');
    results.classList.remove('hidden');

    const topTwo = scored.slice(0, 2);

    top2Container.innerHTML = topTwo.map((shape, index) => {
      const matchPct = Math.round((shape.totalScore / topScore) * 100);
      const isWinner = index === 0;

      return `
        <div class="${isWinner ? 'bg-ink text-on-primary' : 'bg-canvas-soft border border-hairline text-ink'} rounded-lg p-6 relative">
          <div class="flex items-center justify-between mb-2">
            <div>
              <span class="text-caption-mono ${isWinner ? 'text-hairline-strong' : 'text-mute'} uppercase tracking-wide">
                ${isWinner ? '🏆 Primary Recommendation (#1 Fit)' : '🥈 Runner-Up Recommendation (#2 Fit)'}
              </span>
              <h3 class="text-display-md ${isWinner ? 'text-on-primary' : 'text-ink'} font-semibold">${shape.name}</h3>
            </div>
            <div class="text-right">
              <span class="text-display-sm ${isWinner ? 'text-on-primary' : 'text-ink'} font-bold">${matchPct}%</span>
              <span class="text-caption ${isWinner ? 'text-hairline' : 'text-mute'} block">match</span>
            </div>
          </div>

          <p class="text-body-sm ${isWinner ? 'text-hairline-strong' : 'text-mute'} mb-1">${shape.dimensions}</p>
          <p class="text-body-sm ${isWinner ? 'text-hairline' : 'text-body'} mb-4">${shape.description}</p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-3 border-t ${isWinner ? 'border-white/10' : 'border-hairline'}">
            <div>
              <span class="text-caption-mono ${isWinner ? 'text-hairline-strong' : 'text-mute'} uppercase block mb-1">Key Strengths</span>
              <ul class="list-none p-0 m-0 space-y-1 text-caption ${isWinner ? 'text-hairline' : 'text-body'}">
                ${shape.pros.map(p => `<li>✓ ${p}</li>`).join('')}
              </ul>
            </div>
            <div>
              <span class="text-caption-mono ${isWinner ? 'text-hairline-strong' : 'text-mute'} uppercase block mb-1">Tradeoffs</span>
              <ul class="list-none p-0 m-0 space-y-1 text-caption ${isWinner ? 'text-hairline' : 'text-body'}">
                ${shape.cons.map(c => `<li>• ${c}</li>`).join('')}
              </ul>
            </div>
          </div>
        </div>
      `;
    }).join('');

    const winner = scored[0];
    let reasonText = '';
    if (winner.id === 'standard') {
      reasonText = `<strong>Standard Shape</strong> won because your inputs strongly prioritized sweet spot forgiveness, kitchen maneuverability, and doubles dink control. Its 8.0" wide face provides maximum forgiveness on fast net exchanges.`;
    } else if (winner.id === 'hybrid') {
      reasonText = `<strong>Hybrid Shape</strong> won because your priorities are balanced between power, reach, and maneuverability. Its 16.25" × 7.8" footprint gives you extra reach without giving up net quickness.`;
    } else {
      reasonText = `<strong>Elongated Shape</strong> won because you prioritized reach, drive leverage, and/or singles court coverage. Its 16.5" length gives maximum whip momentum on full swings.`;
    }

    explanationEl.innerHTML = `
      <h4 class="text-body-sm-strong text-ink mb-1">Why ${winner.name} ranked #1</h4>
      <p class="text-body-sm text-body">${reasonText}</p>
    `;

    comparisonEl.innerHTML = `
      <table class="w-full text-left text-body-sm border-collapse">
        <thead>
          <tr class="border-b border-hairline">
            <th class="py-2 pr-4 text-caption-mono text-mute uppercase">Feature</th>
            <th class="py-2 px-2 text-caption-mono text-ink uppercase">Standard</th>
            <th class="py-2 px-2 text-caption-mono text-ink uppercase">Hybrid</th>
            <th class="py-2 px-2 text-caption-mono text-ink uppercase">Elongated</th>
          </tr>
        </thead>
        <tbody class="text-body">
          <tr class="border-b border-hairline">
            <td class="py-2 pr-4 font-medium text-ink">Dimensions</td>
            <td class="py-2 px-2">16" × 8"</td>
            <td class="py-2 px-2">16.25" × 7.8"</td>
            <td class="py-2 px-2">16.5" × 7.5"</td>
          </tr>
          <tr class="border-b border-hairline">
            <td class="py-2 pr-4 font-medium text-ink">Sweet Spot Area</td>
            <td class="py-2 px-2 text-emerald-700 dark:text-emerald-400 font-medium">Largest</td>
            <td class="py-2 px-2">Generous</td>
            <td class="py-2 px-2 text-amber-700 dark:text-amber-400">Narrowest</td>
          </tr>
          <tr class="border-b border-hairline">
            <td class="py-2 pr-4 font-medium text-ink">Reach Advantage</td>
            <td class="py-2 px-2">Standard</td>
            <td class="py-2 px-2">+0.25" Reach</td>
            <td class="py-2 px-2 text-emerald-700 dark:text-emerald-400 font-medium">+0.50" Reach</td>
          </tr>
          <tr class="border-b border-hairline">
            <td class="py-2 pr-4 font-medium text-ink">Net Hand Speed</td>
            <td class="py-2 px-2 text-emerald-700 dark:text-emerald-400 font-medium">Fastest</td>
            <td class="py-2 px-2">Balanced</td>
            <td class="py-2 px-2">Moderate</td>
          </tr>
          <tr>
            <td class="py-2 pr-4 font-medium text-ink">Best Game Format</td>
            <td class="py-2 px-2">Doubles / Net Play</td>
            <td class="py-2 px-2">All-Court / Mixed</td>
            <td class="py-2 px-2">Singles / Power Baseline</td>
          </tr>
        </tbody>
      </table>
    `;

    saveState();
  }

  function saveState() {
    try {
      const data = {
        gameStyle: gameStyleSelect.value,
        courtPos: courtPosSelect.value,
        swingStyle: swingStyleSelect.value,
        powerPri: powerPriInput.value,
        controlPri: controlPriInput.value,
        reachPri: reachPriInput.value,
        maneuverPri: maneuverPriInput.value,
      };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    } catch {}
  }

  function loadState() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const data = JSON.parse(raw);
      if (data.gameStyle) gameStyleSelect.value = data.gameStyle;
      if (data.courtPos) courtPosSelect.value = data.courtPos;
      if (data.swingStyle) swingStyleSelect.value = data.swingStyle;
      if (data.powerPri) powerPriInput.value = data.powerPri;
      if (data.controlPri) controlPriInput.value = data.controlPri;
      if (data.reachPri) reachPriInput.value = data.reachPri;
      if (data.maneuverPri) maneuverPriInput.value = data.maneuverPri;
      updateSliderLabels();
    } catch {}
  }

  calcBtn.addEventListener('click', calculate);
  loadState();
</script>