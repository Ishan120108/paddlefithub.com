---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import FAQSection from '../../components/FAQSection.astro';

const relatedTools = [
  {
    title: 'Grip Size Calculator',
    description: 'Find your ideal grip size before your next match.',
    href: '/tools/grip-size-calculator/',
  },
  {
    title: 'Paddle Weight Advisor',
    description: 'Make sure your paddle weight suits your play style.',
    href: '/tools/paddle-weight-advisor/',
  },
  {
    title: 'Paddle Shape Fit',
    description: 'Compare paddle shapes for your game.',
    href: '/tools/paddle-shape-fit/',
  },
];

const faqs = [
  {
    question: 'What is a round robin in pickleball and how does it work?',
    answer: 'A round robin is a tournament or rec play format where every player or team plays against every other player or team in the group. In pickleball doubles round robins, players rotate partners each round so everyone gets equal playing time.',
  },
  {
    question: 'What does round robin mean in pickleball rec play?',
    answer: 'In rec play, a round robin means a structured rotation schedule where 8, 10, 12, or more players share a fixed number of courts (e.g. 2 or 3 courts). The rotation schedule ensures fair partnerships, balanced opponents, and equal bye (sit-out) turns.',
  },
  {
    question: 'How to generate and print pickleball round robin charts?',
    answer: 'Enter your total player count and available court count in our free round robin generator. The tool instantly creates a balanced matrix schedule that you can customize with player names and print out for court-side tracking.',
  },
  {
    question: 'How are byes handled in pickleball round robins with odd numbers?',
    answer: 'When the number of players is not a multiple of 4 (e.g. 5, 9, or 10 players on 2 courts), the schedule rotates byes evenly so every player sits out the exact same number of rounds.',
  },
];
---

<CalculatorLayout
  title="Pickleball Round Robin Generator | PaddleFitHub"
  description="Create fair round-robin rotation schedules for pickleball doubles and singles. Balanced partnerships, court assignments, and bye tracking for any group size."
  heading="Round robin generator."
  intro="Create fair rotation schedules for any group size — doubles or singles. Balanced partnerships, court assignments, and bye tracking, ready to print."
  canonicalPath="/tools/round-robin-generator/"
  relatedTools={relatedTools}
>
  <!-- 1. TOP SECTION: INTERACTIVE CALCULATOR TOOL -->
  <div id="robin-calculator">
    <!-- Form Inputs -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
      <div>
        <label for="num-players" class="text-body-sm-strong text-ink block mb-1">Number of players</label>
        <input type="number" id="num-players" class="form-input" value="8" min="4" max="24" step="1" autocomplete="off" />
        <p id="players-validation" class="text-caption text-error hidden mt-1">Please enter between 4 and 24 players.</p>
      </div>
      <div>
        <label for="num-courts" class="text-body-sm-strong text-ink block mb-1">Number of courts</label>
        <input type="number" id="num-courts" class="form-input" value="2" min="1" max="6" step="1" autocomplete="off" />
        <p id="courts-validation" class="text-caption text-error hidden mt-1"></p>
      </div>
      <div>
        <label for="format-type" class="text-body-sm-strong text-ink block mb-1">Match format</label>
        <select id="format-type" class="form-select">
          <option value="doubles" selected>Doubles (2v2 — 4 players per court)</option>
          <option value="singles">Singles (1v1 — 2 players per court)</option>
        </select>
      </div>
      <div>
        <label for="round-duration" class="text-body-sm-strong text-ink block mb-1">Round duration (min)</label>
        <input type="number" id="round-duration" class="form-input" value="15" min="5" max="60" step="5" autocomplete="off" />
      </div>
    </div>

    <!-- Customizable Player Names -->
    <div class="mb-6">
      <button type="button" id="toggle-names" class="text-body-sm text-link cursor-pointer bg-transparent border-none p-0 hover:underline">
        + Customize player names
      </button>
      <div id="names-panel" class="hidden mt-4 grid grid-cols-2 sm:grid-cols-4 gap-2">
      </div>
    </div>

    <button type="button" id="generate-btn" class="btn-primary mb-8">
      Generate Rotation Schedule
    </button>

    <!-- Results Section -->
    <div id="robin-results" class="hidden space-y-6">
      <!-- Quick Schedule Preview Card -->
      <div class="bg-ink text-on-primary rounded-lg p-6 grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div>
          <span class="text-caption-mono text-hairline-strong uppercase block">Total Rounds</span>
          <span class="text-display-md text-on-primary font-semibold block" id="total-rounds">—</span>
        </div>
        <div>
          <span class="text-caption-mono text-hairline-strong uppercase block">Est. Duration</span>
          <span class="text-display-md text-on-primary font-semibold block" id="total-time">—</span>
        </div>
        <div>
          <span class="text-caption-mono text-hairline-strong uppercase block">Players</span>
          <span class="text-display-md text-on-primary font-semibold block" id="total-players">—</span>
        </div>
        <div>
          <span class="text-caption-mono text-hairline-strong uppercase block">Active Courts</span>
          <span class="text-display-md text-on-primary font-semibold block" id="total-courts-display">—</span>
        </div>
      </div>

      <!-- Compact Preview -->
      <div class="bg-canvas-soft rounded-lg p-4 border border-hairline" id="compact-preview">
        <div class="flex items-center justify-between mb-1">
          <h3 class="text-body-sm-strong text-ink">Schedule Overview</h3>
          <span class="text-caption-mono text-mute" id="format-tag">Doubles Format</span>
        </div>
        <div id="preview-content" class="text-body-sm text-body">
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap gap-3">
        <button type="button" id="copy-btn" class="btn-secondary">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mr-1 inline-block"><rect x="2" y="6" width="10" height="9" rx="1"/><path d="M4 5V3a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1h-2"/></svg>
          Copy Schedule
        </button>
        <button type="button" id="print-btn" class="btn-secondary">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mr-1 inline-block"><path d="M4 5V2h8v3"/><rect x="2" y="5" width="12" height="6" rx="1"/><path d="M4 11v3h8v-3"/><path d="M4 8h8"/></svg>
          Print Schedule
        </button>
      </div>

      <!-- Schedule Table -->
      <div class="overflow-x-auto border border-hairline rounded-lg bg-canvas">
        <table class="w-full text-body-sm border-collapse" id="schedule-table">
        </table>
      </div>

      <!-- Bye Section -->
      <div id="bye-section" class="hidden bg-canvas-soft rounded-lg p-5 border border-hairline space-y-2">
        <h3 class="text-body-sm-strong text-ink">Bye Tracking &amp; Sit-Out Rotations</h3>
        <div id="bye-info" class="text-body-sm text-body"></div>
        <p id="bye-explanation" class="text-caption text-mute mt-1"></p>
      </div>

      <!-- Fairness Guarantee -->
      <div class="bg-canvas-soft rounded-lg p-4 border border-hairline">
        <p class="text-caption text-body">
          <strong>⚖ Fairness Guarantee:</strong> This rotation schedule is mathematically constructed using polygon scheduling. In Doubles, every player partners with every other player once (or sits out equally). In Singles, every player faces every opponent.
        </p>
      </div>
    </div>
  </div>

  <!-- 2. STEP-BY-STEP GUIDE SECTION -->
  <section class="mt-12 pt-8 border-t border-hairline">
    <h2 class="text-display-sm text-ink mb-4">How to Use This Tool</h2>
    <ol class="list-decimal pl-5 space-y-2 text-body-sm text-body">
      <li><strong>Enter total player count:</strong> Input between 4 and 24 players attending your session.</li>
      <li><strong>Enter available court count:</strong> Input active courts (1 to 6).</li>
      <li><strong>Select match format:</strong> Choose Doubles (2v2 — 4 players/court) or Singles (1v1 — 2 players/court).</li>
      <li><strong>Set round duration:</strong> Input estimated minutes per round (e.g. 15 min).</li>
      <li><strong>Optionally customize player names:</strong> Click <em>+ Customize player names</em> to enter actual player names.</li>
      <li><strong>Click Generate Rotation Schedule:</strong> Review round-by-round court assignments, bye tracking, and use <em>Copy Schedule</em> or <em>Print Schedule</em>.</li>
    </ol>
  </section>

  <!-- 3. FORMULA & CALCULATION METHOD SECTION -->
  <section class="mt-8 pt-8 border-t border-hairline">
    <h2 class="text-display-sm text-ink mb-3">How the Result is Calculated</h2>
    <p class="text-body-sm text-body mb-4">
      We use polygon circle scheduling to construct an exact round-robin matrix. Player 1 remains fixed at position zero while all other players rotate clockwise each round. In Doubles, pairings are formed from opposite points on the polygon circle. In Singles, direct radial pairings are formed. If player count is odd, a dummy "BYE" is added to distribute sit-out rounds equally.
    </p>

    <div class="bg-canvas-soft p-4 rounded-md font-mono text-caption border border-hairline space-y-1">
      <div>If Player Count (N) is Odd → Size (S) = N + 1 (with dummy "BYE")</div>
      <div>Total Rounds = S − 1</div>
      <div>Active Matches per Round = Min(Available Courts, Floor(S / PlayersPerCourt))</div>
    </div>
  </section>

  <!-- 4. REAL-WORLD EXAMPLES SECTION -->
  <section class="mt-8 pt-8 border-t border-hairline">
    <h2 class="text-display-sm text-ink mb-4">Real-World Examples</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-canvas-soft p-4 rounded-lg border border-hairline">
        <span class="text-caption-mono text-mute uppercase block mb-1">Example A: 8 Players on 2 Courts (Doubles)</span>
        <p class="text-body-sm text-ink font-medium mb-1">8 players, 2 courts, Doubles format (15 min rounds)</p>
        <p class="text-caption text-body">
          Generates <strong>7 rounds (105 min total)</strong>. All 8 players stay active on Court 1 and Court 2 every round with zero byes. Every player partners with every other player once.
        </p>
      </div>

      <div class="bg-canvas-soft p-4 rounded-lg border border-hairline">
        <span class="text-caption-mono text-mute uppercase block mb-1">Example B: 5 Players on 1 Court (Singles)</span>
        <p class="text-body-sm text-ink font-medium mb-1">5 players, 1 court, Singles format (15 min rounds)</p>
        <p class="text-caption text-body">
          Generates <strong>5 rounds (75 min total)</strong>. 1 match per round on Court 1 (2 players active), 3 players sit out (byes) per round, rotating so everyone plays 2 matches and gets 3 byes.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FAQSection title="Pickleball Round Robin FAQs" faqs={faqs} />
</CalculatorLayout>

<script>
  const STORAGE_KEY = 'paddlefit_round_robin_state';

  const numPlayersInput = document.getElementById('num-players') as HTMLInputElement;
  const numCourtsInput = document.getElementById('num-courts') as HTMLInputElement;
  const formatTypeInput = document.getElementById('format-type') as HTMLSelectElement;
  const roundDurationInput = document.getElementById('round-duration') as HTMLInputElement;

  const toggleNamesBtn = document.getElementById('toggle-names') as HTMLButtonElement;
  const namesPanel = document.getElementById('names-panel') as HTMLDivElement;
  const generateBtn = document.getElementById('generate-btn') as HTMLButtonElement;

  const results = document.getElementById('robin-results') as HTMLDivElement;
  const totalRoundsEl = document.getElementById('total-rounds') as HTMLSpanElement;
  const totalTimeEl = document.getElementById('total-time') as HTMLSpanElement;
  const totalPlayersEl = document.getElementById('total-players') as HTMLSpanElement;
  const totalCourtsDisplay = document.getElementById('total-courts-display') as HTMLSpanElement;

  const formatTag = document.getElementById('format-tag') as HTMLSpanElement;
  const previewContent = document.getElementById('preview-content') as HTMLDivElement;
  const scheduleTable = document.getElementById('schedule-table') as HTMLTableElement;

  const byeSection = document.getElementById('bye-section') as HTMLDivElement;
  const byeInfo = document.getElementById('bye-info') as HTMLDivElement;
  const byeExplanation = document.getElementById('bye-explanation') as HTMLParagraphElement;

  const copyBtn = document.getElementById('copy-btn') as HTMLButtonElement;
  const printBtn = document.getElementById('print-btn') as HTMLButtonElement;

  let playerNames: string[] = [];

  function updateNameInputs() {
    const count = Math.max(4, Math.min(24, parseInt(numPlayersInput.value) || 8));
    namesPanel.innerHTML = '';
    playerNames = [];
    for (let i = 0; i < count; i++) {
      const name = `Player ${i + 1}`;
      playerNames.push(name);
      const input = document.createElement('input');
      input.type = 'text';
      input.value = name;
      input.className = 'form-input';
      input.dataset.index = String(i);
      input.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        const idx = parseInt(target.dataset.index || '0');
        playerNames[idx] = target.value.trim() || `Player ${idx + 1}`;
      });
      namesPanel.appendChild(input);
    }
  }

  numPlayersInput.addEventListener('change', updateNameInputs);
  updateNameInputs();

  toggleNamesBtn.addEventListener('click', () => {
    namesPanel.classList.toggle('hidden');
    toggleNamesBtn.textContent = namesPanel.classList.contains('hidden')
      ? '+ Customize player names'
      : '− Hide player names';
  });

  function validate(): boolean {
    const p = parseInt(numPlayersInput.value);
    const c = parseInt(numCourtsInput.value);
    const isDoubles = formatTypeInput.value === 'doubles';

    const pErr = document.getElementById('players-validation') as HTMLParagraphElement;
    const cErr = document.getElementById('courts-validation') as HTMLParagraphElement;

    pErr.classList.add('hidden');
    cErr.classList.add('hidden');

    if (isNaN(p) || p < 4 || p > 24) {
      pErr.classList.remove('hidden');
      return false;
    }

    const playersPerCourt = isDoubles ? 4 : 2;
    const maxCourtsNeeded = Math.floor(p / playersPerCourt);

    if (isNaN(c) || c < 1 || c > 6) {
      cErr.textContent = `Please enter between 1 and 6 courts.`;
      cErr.classList.remove('hidden');
      return false;
    }

    if (c > maxCourtsNeeded && maxCourtsNeeded > 0) {
      cErr.textContent = `With ${p} players in ${isDoubles ? 'Doubles' : 'Singles'}, only ${maxCourtsNeeded} court(s) can be active simultaneously.`;
      cErr.classList.remove('hidden');
    }

    return true;
  }

  interface Match {
    court: number;
    team1: string[];
    team2: string[];
  }

  interface RoundData {
    roundNum: number;
    matches: Match[];
    byes: string[];
  }

  function buildSchedule(n: number, isDoubles: boolean, numCourts: number): RoundData[] {
    const isOdd = n % 2 !== 0;
    const size = isOdd ? n + 1 : n;
    const names = [...playerNames.slice(0, n)];
    if (isOdd) names.push('BYE');

    const roundsCount = size - 1;
    const schedule: RoundData[] = [];

    const fixed = names[0];
    const rotating = names.slice(1);

    for (let r = 0; r < roundsCount; r++) {
      const lineup = [fixed, ...rotating];
      const pairList: [string, string][] = [];

      for (let i = 0; i < size / 2; i++) {
        pairList.push([lineup[i], lineup[size - 1 - i]]);
      }

      const rawByes: string[] = [];
      const validPairs = pairList.filter(([a, b]) => {
        if (a === 'BYE') { rawByes.push(b); return false; }
        if (b === 'BYE') { rawByes.push(a); return false; }
        return true;
      });

      const matches: Match[] = [];
      const extraByes: string[] = [];

      if (isDoubles) {
        let courtIdx = 1;
        for (let i = 0; i < validPairs.length - 1; i += 2) {
          if (courtIdx <= numCourts) {
            matches.push({
              court: courtIdx++,
              team1: [validPairs[i][0], validPairs[i][1]],
              team2: [validPairs[i + 1][0], validPairs[i + 1][1]],
            });
          } else {
            extraByes.push(validPairs[i][0], validPairs[i][1], validPairs[i + 1][0], validPairs[i + 1][1]);
          }
        }
        if (validPairs.length % 2 !== 0) {
          const leftover = validPairs[validPairs.length - 1];
          extraByes.push(leftover[0], leftover[1]);
        }
      } else {
        let courtIdx = 1;
        validPairs.forEach(pair => {
          if (courtIdx <= numCourts) {
            matches.push({
              court: courtIdx++,
              team1: [pair[0]],
              team2: [pair[1]],
            });
          } else {
            extraByes.push(pair[0], pair[1]);
          }
        });
      }

      schedule.push({
        roundNum: r + 1,
        matches,
        byes: [...rawByes, ...extraByes],
      });

      rotating.unshift(rotating.pop()!);
    }

    return schedule;
  }

  function generate() {
    if (!validate()) return;

    const numPlayers = Math.max(4, Math.min(24, parseInt(numPlayersInput.value) || 8));
    const numCourts = Math.max(1, Math.min(6, parseInt(numCourtsInput.value) || 2));
    const duration = parseInt(roundDurationInput.value) || 15;
    const isDoubles = formatTypeInput.value === 'doubles';

    while (playerNames.length < numPlayers) {
      playerNames.push(`Player ${playerNames.length + 1}`);
    }

    const schedule = buildSchedule(numPlayers, isDoubles, numCourts);

    results.classList.remove('hidden');
    totalRoundsEl.textContent = String(schedule.length);
    totalTimeEl.textContent = `${schedule.length * duration} min`;
    totalPlayersEl.textContent = String(numPlayers);
    totalCourtsDisplay.textContent = String(numCourts);
    formatTag.textContent = isDoubles ? 'Doubles Format (2v2)' : 'Singles Format (1v1)';

    const totalMatches = schedule.reduce((acc, r) => acc + r.matches.length, 0);
    previewContent.innerHTML = `
      <span><strong>${numPlayers} players</strong> playing ${isDoubles ? 'Doubles' : 'Singles'} on <strong>${numCourts} court(s)</strong> across <strong>${schedule.length} rounds</strong> (${totalMatches} total matches).</span>
    `;

    const courtThs = Array.from({ length: numCourts }, (_, i) => `<th class="py-2 px-3 text-left text-caption-mono text-mute uppercase">Court ${i + 1}</th>`).join('');
    scheduleTable.innerHTML = `
      <thead>
        <tr class="border-b border-hairline bg-canvas-soft">
          <th class="py-2 px-3 text-left text-caption-mono text-mute uppercase w-20">Round</th>
          ${courtThs}
          <th class="py-2 px-3 text-left text-caption-mono text-mute uppercase">Sitting Out (Bye)</th>
        </tr>
      </thead>
      <tbody class="text-body">
        ${schedule.map(r => {
          const matchTds = Array.from({ length: numCourts }, (_, ci) => {
            const m = r.matches.find(item => item.court === ci + 1);
            if (m) {
              if (isDoubles) {
                return `<td class="py-3 px-3"><span class="font-medium text-ink">${m.team1[0]} &amp; ${m.team1[1]}</span><br><span class="text-caption text-mute">vs</span><br><span class="font-medium text-ink">${m.team2[0]} &amp; ${m.team2[1]}</span></td>`;
              }
              return `<td class="py-3 px-3"><span class="font-medium text-ink">${m.team1[0]}</span> <span class="text-caption text-mute">vs</span> <span class="font-medium text-ink">${m.team2[0]}</span></td>`;
            }
            return `<td class="py-3 px-3 text-mute">—</td>`;
          }).join('');

          const byeTd = r.byes.length > 0
            ? `<td class="py-3 px-3 text-mute">${r.byes.join(', ')}</td>`
            : `<td class="py-3 px-3 text-mute">None</td>`;

          return `<tr class="border-b border-hairline"><td class="py-3 px-3 font-semibold text-ink">Round ${r.roundNum}</td>${matchTds}${byeTd}</tr>`;
        }).join('')}
      </tbody>
    `;

    const hasByes = schedule.some(r => r.byes.length > 0);
    if (hasByes) {
      byeSection.classList.remove('hidden');
      const counts: Record<string, number> = {};
      schedule.forEach(r => {
        r.byes.forEach(b => {
          counts[b] = (counts[b] || 0) + 1;
        });
      });

      byeInfo.innerHTML = Object.entries(counts)
        .sort(([, a], [, b]) => b - a)
        .map(([name, cnt]) => `<span class="inline-block mr-4 mb-1"><strong>${name}</strong>: ${cnt} bye${cnt > 1 ? 's' : ''}</span>`)
        .join('');

      byeExplanation.textContent = numPlayers % 2 !== 0
        ? `With ${numPlayers} players (odd count), each round requires players to sit out. Byes are rotated fairly.`
        : `Due to court capacity (${numCourts} court(s) for ${numPlayers} players), sit-out rotations are distributed as evenly as possible.`;
    } else {
      byeSection.classList.add('hidden');
    }

    saveState();
  }

  copyBtn.addEventListener('click', () => {
    const isDoubles = formatTypeInput.value === 'doubles';
    const numPlayers = parseInt(numPlayersInput.value) || 8;
    const numCourts = parseInt(numCourtsInput.value) || 2;
    const schedule = buildSchedule(numPlayers, isDoubles, numCourts);

    let text = `Pickleball Round-Robin Schedule (${numPlayers} Players, ${isDoubles ? 'Doubles' : 'Singles'}, ${numCourts} Courts)\n\n`;

    schedule.forEach(r => {
      text += `Round ${r.roundNum}:\n`;
      r.matches.forEach(m => {
        if (isDoubles) {
          text += `  Court ${m.court}: ${m.team1[0]} & ${m.team1[1]} vs ${m.team2[0]} & ${m.team2[1]}\n`;
        } else {
          text += `  Court ${m.court}: ${m.team1[0]} vs ${m.team2[0]}\n`;
        }
      });
      if (r.byes.length > 0) {
        text += `  Bye: ${r.byes.join(', ')}\n`;
      }
      text += '\n';
    });

    navigator.clipboard.writeText(text).then(() => {
      const orig = copyBtn.innerHTML;
      copyBtn.innerHTML = '✓ Copied Schedule!';
      setTimeout(() => { copyBtn.innerHTML = orig; }, 2000);
    });
  });

  printBtn.addEventListener('click', () => {
    window.print();
  });

  function saveState() {
    try {
      const data = {
        players: numPlayersInput.value,
        courts: numCourtsInput.value,
        format: formatTypeInput.value,
        duration: roundDurationInput.value,
      };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    } catch {}
  }

  function loadState() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const data = JSON.parse(raw);
      if (data.players) numPlayersInput.value = data.players;
      if (data.courts) numCourtsInput.value = data.courts;
      if (data.format) formatTypeInput.value = data.format;
      if (data.duration) roundDurationInput.value = data.duration;
      updateNameInputs();
    } catch {}
  }

  numCourtsInput.addEventListener('change', () => {
    if (!results.classList.contains('hidden')) generate();
    saveState();
  });
  formatTypeInput.addEventListener('change', () => {
    if (!results.classList.contains('hidden')) generate();
    saveState();
  });

  generateBtn.addEventListener('click', generate);
  loadState();
</script>

<style>
  @media print {
    header, footer, nav, button, .btn-primary, .btn-secondary, #toggle-names, #names-panel {
      display: none !important;
    }
    body {
      background: white !important;
      color: black !important;
    }
    #robin-results {
      display: block !important;
    }
  }
</style>
