---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import FAQSection from '../../components/FAQSection.astro';

const relatedTools = [
  {
    title: 'Grip Size Calculator',
    description: 'Verify your grip size fit (Undersized grips cause forearm strain).',
    href: '/tools/grip-size-calculator/',
  },
  {
    title: 'Core Thickness Advisor',
    description: 'Compare 16 mm vs 20 mm vibration absorbing cores.',
    href: '/tools/core-thickness-advisor/',
  },
  {
    title: 'Paddle Weight Advisor',
    description: 'Check target weight ranges for your play style.',
    href: '/tools/paddle-weight-advisor/',
  },
];

const faqs = [
  {
    question: 'How does pickleball paddle weight affect arm and elbow pain?',
    answer: 'Paddle weight is a double-edged sword. Ultralight paddles (< 7.3 oz) lack mass to resist ball momentum, transferring higher recoil vibration to your wrist and elbow. Heavyweight paddles (> 8.3 oz) absorb ball shock better but cause shoulder fatigue and flexor tendon strain over long sessions. A midweight 7.5 to 8.1 oz (213–230g) paddle usually balances recoil shock and muscle fatigue best.',
  },
  {
    question: 'Why is core thickness crucial for tennis elbow prevention?',
    answer: 'Thicker polypropylene cores (16mm to 20mm) flex slightly more on contact, dispersing shock waves laterally across the honeycomb cells before vibration travels down the handle. Thin 14mm cores generate crisp pop but transfer sharper high-frequency shock into your arm joints.',
  },
  {
    question: 'Can an incorrect grip size cause tennis elbow?',
    answer: 'Yes. An undersized grip forces your hand to squeeze tightly ("death-grip") to keep the paddle from twisting on mis-hits. This isometric muscle contraction strains the extensor tendons at the lateral epicondyle. Using the Vernier measurement method to find your exact grip size allows your forearm muscles to relax.',
  },
  {
    question: 'Should I stop playing completely if I experience arm pain?',
    answer: 'If you feel sharp joint pain, stop playing immediately and rest. Equipment optimization can reduce shock accumulation, but persistent pain requires diagnosis from a physical therapist or medical specialist.',
  },
];
---

<CalculatorLayout
  title="Arm-Friendly Pickleball Paddle Finder | PaddleFitHub"
  description="Calculate arm-friendly pickleball paddle specs for tennis elbow, golfer's elbow, wrist fatigue, and shoulder strain. Supports ounces (oz), grams (g), inches (in), and cm."
  heading="Arm-friendly paddle finder."
  intro="Equipment choices directly affect impact shock transmission to your joints. Select your discomfort profile to calculate customized target weight, core thickness, and shape recommendations in oz, grams, inches, and cm."
  canonicalPath="/tools/arm-friendly-paddle-finder/"
  relatedTools={relatedTools}
>
  <!-- Prominent Medical Disclaimer -->
  <div class="my-6 p-5 rounded-lg bg-warning-soft/30 border border-warning/40 text-body-sm text-ink">
    <div class="flex items-start gap-3">
      <svg class="w-5 h-5 text-warning-deep shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
      <div>
        <p class="font-semibold text-ink m-0 mb-1">Equipment Comfort Disclaimer (Not Medical Advice)</p>
        <p class="m-0 text-body text-xs leading-relaxed">Spec recommendations provided by this calculator are intended for equipment comfort and playability optimization only and do not constitute medical advice. If you experience persistent arm, elbow, or wrist pain, stop play and consult a qualified medical professional or physical therapist.</p>
      </div>
    </div>
  </div>

  <!-- 1. TOP SECTION: INTERACTIVE CALCULATOR TOOL -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12" id="arm-calculator">
    <!-- ── Left Column: Form Inputs ── -->
    <div>
      <h2 class="text-display-sm text-ink mb-6">1. Your comfort profile</h2>

      <div class="mb-6">
        <label for="arm-issue" class="text-body-sm-strong text-ink block mb-1">Primary area of discomfort</label>
        <select id="arm-issue" class="form-select">
          <option value="tennis-elbow" selected>Outer Elbow (Lateral forearm strain)</option>
          <option value="golfers-elbow">Inner Elbow (Medial forearm strain)</option>
          <option value="wrist">Wrist / Hand fatigue</option>
          <option value="shoulder">Shoulder joint torque</option>
          <option value="general">General arm strain prevention</option>
        </select>
      </div>

      <div class="mb-6">
        <label for="severity" class="text-body-sm-strong text-ink block mb-1">Discomfort frequency</label>
        <select id="severity" class="form-select">
          <option value="mild" selected>Mild / Occasional tightness after play</option>
          <option value="moderate">Moderate / Noticeable discomfort during rallies</option>
          <option value="severe">Significant / Limits play duration &amp; stroke power</option>
        </select>
      </div>

      <div class="mb-6">
        <div class="flex items-center justify-between mb-1">
          <label for="current-paddle-weight" class="text-body-sm-strong text-ink block" id="weight-label">Current paddle weight (oz)</label>
          <div class="inline-flex rounded border border-hairline p-0.5 text-caption font-medium bg-canvas-soft">
            <button type="button" id="unit-oz-btn" class="px-2.5 py-0.5 rounded bg-ink text-on-primary font-semibold transition-all cursor-pointer">oz</button>
            <button type="button" id="unit-g-btn" class="px-2.5 py-0.5 rounded text-mute hover:text-ink transition-all cursor-pointer">grams (g)</button>
          </div>
        </div>
        <input type="number" id="current-paddle-weight" class="form-input" placeholder="e.g. 7.8" step="0.1" min="5.0" max="12.0" value="7.8" />
        <p class="text-caption text-mute mt-1 m-0" id="weight-hint">Leave default if unknown (typical: 7.0 – 8.5 oz / 198 – 241 g).</p>
      </div>

      <div class="mb-6">
        <label for="current-core" class="text-body-sm-strong text-ink block mb-1">Current core thickness</label>
        <select id="current-core" class="form-select">
          <option value="14">14 mm (Thin core / High pop)</option>
          <option value="16" selected>16 mm (Standard balanced core)</option>
          <option value="20">20 mm (Thick dampening core)</option>
          <option value="unknown">Not sure</option>
        </select>
      </div>

      <button id="calc-arm-btn" class="btn-primary w-full justify-center">
        Generate Comfort Specs
      </button>
    </div>

    <!-- ── Right Column: Output Card ── -->
    <div>
      <h2 class="text-display-sm text-ink mb-6">2. Shock-absorption recommendations</h2>

      <div id="arm-placeholder" class="bg-canvas-soft rounded-lg p-6 text-center border border-hairline min-h-[300px] flex flex-col items-center justify-center">
        <p class="text-body-sm text-mute m-0">
          Set your comfort profile and click <strong>Generate Comfort Specs</strong> to view customized paddle specifications.
        </p>
      </div>

      <div id="arm-results" class="hidden space-y-6">
        <div class="bg-canvas-soft rounded-lg p-5 border border-hairline space-y-3">
          <span class="text-caption-mono text-cyan-deep uppercase font-semibold">Primary Recommended Setup</span>
          <div class="space-y-1 text-body-sm">
            <p>• <strong>Target Weight:</strong> <span id="primary-weight">7.8 – 8.1 oz (221 – 230 g)</span></p>
            <p>• <strong>Core Thickness:</strong> <span id="primary-core">16 mm or 20 mm</span></p>
            <p>• <strong>Shape Geometry:</strong> <span id="primary-shape">Standard Wide Face (16" × 8" / 40.6 cm × 20.3 cm)</span></p>
          </div>
        </div>

        <div class="bg-canvas-soft rounded-lg p-5 border border-hairline space-y-3">
          <span class="text-caption-mono text-mute uppercase font-semibold">Backup / Alternative Setup</span>
          <div class="space-y-1 text-body-sm text-body">
            <p>• <strong>Target Weight:</strong> <span id="backup-weight">7.5 – 7.8 oz (213 – 221 g)</span></p>
            <p>• <strong>Core Thickness:</strong> <span id="backup-core">16 mm Standard</span></p>
            <p>• <strong>Shape:</strong> <span id="backup-shape">Standard Wide Face</span></p>
          </div>
        </div>

        <div class="bg-canvas-soft rounded-lg p-5 border border-hairline space-y-2">
          <h3 class="text-body-sm-strong text-ink text-error">🚫 Equipment Features to Avoid</h3>
          <ul class="list-none p-0 m-0 space-y-1 text-body-sm text-body" id="avoid-list">
          </ul>
        </div>

        <div class="bg-canvas-soft rounded-lg p-4 border border-hairline">
          <p class="text-caption text-body" id="pro-note-text">
            <strong>Check with a Professional:</strong> Warm-up routines, proper stroke mechanics, and forearm strengthening are often more impactful than equipment changes alone.
          </p>
        </div>

        <div class="pt-4 border-t border-hairline">
          <h3 class="text-body-sm-strong text-ink mb-3">Recommended next steps</h3>
          <div class="space-y-2">
            <a href="/tools/grip-size-calculator/" class="flex items-center gap-2 text-body-sm text-link hover:underline">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7H11M11 7L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Verify your grip size fit (Undersized grips cause forearm strain)
            </a>
            <a href="/tools/core-thickness-advisor/" class="flex items-center gap-2 text-body-sm text-link hover:underline">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7H11M11 7L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Compare 16 mm vs 20 mm vibration absorbing cores
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 2. STEP-BY-STEP GUIDE SECTION -->
  <section class="mt-12 pt-8 border-t border-hairline">
    <h2 class="text-display-sm text-ink mb-4">How to Use This Tool</h2>
    <ol class="list-decimal pl-5 space-y-2 text-body-sm text-body">
      <li><strong>Select primary discomfort area:</strong> Outer elbow (tennis elbow), inner elbow (golfer's elbow), wrist, or shoulder.</li>
      <li><strong>Select discomfort severity:</strong> Mild, moderate, or significant.</li>
      <li><strong>Enter current paddle weight:</strong> Input in ounces (oz) or grams (g) using the unit selector toggle.</li>
      <li><strong>Select current core thickness:</strong> 14mm, 16mm, or 20mm core depth.</li>
      <li><strong>Click Generate Comfort Specs:</strong> Review your primary and backup recommended specs in oz, grams, inches, and cm.</li>
    </ol>
  </section>

  <!-- 3. REAL-WORLD EXAMPLES SECTION -->
  <section class="mt-8 pt-8 border-t border-hairline">
    <h2 class="text-display-sm text-ink mb-4">Real-World Examples</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-canvas-soft p-4 rounded-lg border border-hairline">
        <span class="text-caption-mono text-mute uppercase block mb-1">Example A: Outer Elbow Strain</span>
        <p class="text-body-sm text-ink font-medium mb-1">Currently playing 7.2 oz ultralight paddle with 14mm core</p>
        <p class="text-caption text-body">
          Recommends increasing static weight to <strong>7.8–8.1 oz (221–230 g)</strong> and upgrading to a <strong>16mm or 20mm core</strong> to dampen recoil shock.
        </p>
      </div>

      <div class="bg-canvas-soft p-4 rounded-lg border border-hairline">
        <span class="text-caption-mono text-mute uppercase block mb-1">Example B: Shoulder Strain</span>
        <p class="text-body-sm text-ink font-medium mb-1">Currently playing heavy 8.5 oz head-heavy elongated paddle</p>
        <p class="text-caption text-body">
          Recommends reducing static weight to <strong>7.3–7.7 oz (207–218 g)</strong> and switching to a standard shape (16" × 8" / 40.6 cm × 20.3 cm) to lower rotational inertia.
        </p>
      </div>
    </div>
  </section>

  <!-- Related Guide Banner -->
  <div class="mt-8 p-4 bg-canvas-soft border border-hairline rounded-lg flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
    <div>
      <p class="text-body-sm-strong text-ink m-0">Dealing with tennis elbow or arm fatigue on court?</p>
      <p class="text-caption text-mute m-0">Read our complete guide on how core thickness, paddle weight, and grip fit combine to reduce impact shock.</p>
    </div>
    <a href="/blog/arm-friendly-paddle-tips/" class="btn-secondary text-caption whitespace-nowrap shrink-0">Read Arm Comfort Tips →</a>
  </div>

  <!-- FAQ Section -->
  <FAQSection title="Arm-Friendly Paddle FAQs" faqs={faqs} />
</CalculatorLayout>

<script>
  const STORAGE_KEY = 'paddlefit_arm_comfort_state';

  const issueSelect = document.getElementById('arm-issue') as HTMLSelectElement;
  const severitySelect = document.getElementById('severity') as HTMLSelectElement;
  const weightInput = document.getElementById('current-paddle-weight') as HTMLInputElement;
  const weightLabel = document.getElementById('weight-label') as HTMLLabelElement;
  const weightHint = document.getElementById('weight-hint') as HTMLParagraphElement;
  const coreSelect = document.getElementById('current-core') as HTMLSelectElement;

  const unitOzBtn = document.getElementById('unit-oz-btn') as HTMLButtonElement;
  const unitGBtn = document.getElementById('unit-g-btn') as HTMLButtonElement;

  const calcBtn = document.getElementById('calc-arm-btn') as HTMLButtonElement;
  const placeholder = document.getElementById('arm-placeholder') as HTMLDivElement;
  const results = document.getElementById('arm-results') as HTMLDivElement;

  const primaryWeight = document.getElementById('primary-weight') as HTMLParagraphElement;
  const primaryCore = document.getElementById('primary-core') as HTMLParagraphElement;
  const primaryShape = document.getElementById('primary-shape') as HTMLParagraphElement;

  const backupWeight = document.getElementById('backup-weight') as HTMLSpanElement;
  const backupCore = document.getElementById('backup-core') as HTMLSpanElement;
  const backupShape = document.getElementById('backup-shape') as HTMLSpanElement;

  const avoidList = document.getElementById('avoid-list') as HTMLUListElement;
  const proNoteText = document.getElementById('pro-note-text') as HTMLParagraphElement;

  let activeWeightUnit: 'oz' | 'g' = 'oz';

  function setWeightUnit(unit: 'oz' | 'g') {
    if (activeWeightUnit === unit) return;

    const currentVal = parseFloat(weightInput.value);
    activeWeightUnit = unit;

    if (unit === 'oz') {
      unitOzBtn.className = 'px-2.5 py-0.5 rounded bg-ink text-on-primary font-semibold transition-all cursor-pointer';
      unitGBtn.className = 'px-2.5 py-0.5 rounded text-mute hover:text-ink transition-all cursor-pointer';
      weightLabel.textContent = 'Current paddle weight (oz)';
      weightHint.textContent = 'Leave default if unknown (typical: 7.0 – 8.5 oz).';
      weightInput.placeholder = 'e.g. 7.8';
      weightInput.step = '0.1';
      weightInput.min = '5.0';
      weightInput.max = '12.0';

      if (!isNaN(currentVal) && currentVal > 20) {
        weightInput.value = (currentVal / 28.3495).toFixed(1);
      }
    } else {
      unitGBtn.className = 'px-2.5 py-0.5 rounded bg-ink text-on-primary font-semibold transition-all cursor-pointer';
      unitOzBtn.className = 'px-2.5 py-0.5 rounded text-mute hover:text-ink transition-all cursor-pointer';
      weightLabel.textContent = 'Current paddle weight (grams / g)';
      weightHint.textContent = 'Leave default if unknown (typical: 198 – 241 g).';
      weightInput.placeholder = 'e.g. 221';
      weightInput.step = '1';
      weightInput.min = '140';
      weightInput.max = '340';

      if (!isNaN(currentVal) && currentVal < 20) {
        weightInput.value = Math.round(currentVal * 28.3495).toString();
      }
    }
    saveState();
  }

  unitOzBtn.addEventListener('click', () => setWeightUnit('oz'));
  unitGBtn.addEventListener('click', () => setWeightUnit('g'));

  function calculate() {
    const issue = issueSelect.value;
    const severity = severitySelect.value;
    const isSevere = severity === 'severe';

    placeholder.classList.add('hidden');
    results.classList.remove('hidden');

    if (issue === 'tennis-elbow') {
      primaryWeight.textContent = '7.8 – 8.1 oz (221 – 230 g) — Midweight absorbs shock better than ultralight';
      primaryCore.textContent = '16 mm or 20 mm (Thicker honeycomb absorbs frame vibration)';
      primaryShape.textContent = 'Standard Wide Face (16" × 8" / 40.6 cm × 20.3 cm provides max sweet spot)';

      backupWeight.textContent = '7.5 – 7.8 oz (213 – 221 g)';
      backupCore.textContent = '16 mm Standard';
      backupShape.textContent = 'Hybrid (16.25" × 7.8" / 41.3 cm × 19.8 cm)';

      avoidList.innerHTML = `
        <li>• Ultralight paddles (&lt; 7.3 oz / 207 g) — Lack mass to absorb impact recoil.</li>
        <li>• Ultra-thin cores (14 mm) — Transmit stiff impact energy.</li>
        <li>• Undersized grip circumferences — Cause tight death-gripping.</li>
      `;
    } else if (issue === 'golfers-elbow') {
      primaryWeight.textContent = '7.6 – 8.0 oz (215 – 227 g)';
      primaryCore.textContent = '16 mm Core';
      primaryShape.textContent = 'Standard or Hybrid';

      backupWeight.textContent = '7.4 – 7.7 oz (210 – 218 g)';
      backupCore.textContent = '16 mm Core';
      backupShape.textContent = 'Standard Wide Face (16" × 8" / 40.6 cm × 20.3 cm)';

      avoidList.innerHTML = `
        <li>• Heavy paddles (&gt; 8.3 oz / 235 g) — Load inner forearm flexor tendons.</li>
        <li>• Oversized grips — Force fingers open and strain tendons.</li>
        <li>• Stiff carbon faces without soft overgrips.</li>
      `;
    } else if (issue === 'wrist') {
      primaryWeight.textContent = '7.5 – 7.8 oz (213 – 221 g) — Handle-heavy balance';
      primaryCore.textContent = '16 mm Core';
      primaryShape.textContent = 'Standard Wide Face (Fast net maneuverability)';

      backupWeight.textContent = '7.3 – 7.6 oz (207 – 215 g)';
      backupCore.textContent = '16 mm Core';
      backupShape.textContent = 'Standard Shape';

      avoidList.innerHTML = `
        <li>• Head-heavy elongated paddles — High swing weight causes wrist drag.</li>
        <li>• Extreme wrist flicking shots — Focus on shoulder rotation.</li>
      `;
    } else if (issue === 'shoulder') {
      primaryWeight.textContent = '7.3 – 7.7 oz (207 – 218 g) — Reduces shoulder torque';
      primaryCore.textContent = '16 mm Core';
      primaryShape.textContent = 'Standard Shape (Low swing weight)';

      backupWeight.textContent = '7.0 – 7.4 oz (198 – 210 g)';
      backupCore.textContent = '16 mm Core';
      backupShape.textContent = 'Standard Shape';

      avoidList.innerHTML = `
        <li>• Heavy paddles (&gt; 8.2 oz / 232 g) — Heavy rotational drag on shoulder joint.</li>
        <li>• Extended 16.5" elongated shapes with top-heavy balance.</li>
      `;
    } else {
      primaryWeight.textContent = '7.7 – 8.0 oz (218 – 227 g)';
      primaryCore.textContent = '16 mm Core';
      primaryShape.textContent = 'Standard or Hybrid';

      backupWeight.textContent = '7.5 – 7.8 oz (213 – 221 g)';
      backupCore.textContent = '16 mm Core';
      backupShape.textContent = 'Standard Shape';

      avoidList.innerHTML = `
        <li>• Thin 14 mm cores that increase vibration.</li>
        <li>• Worn out grips that cause paddle slippage.</li>
      `;
    }

    if (isSevere) {
      proNoteText.innerHTML = `
        <strong>⚠ Rest &amp; Care Advisory:</strong> Since you indicated significant discomfort that limits play, rest and consulting a physician or physical therapist is strongly advised before attempting equipment changes.
      `;
    } else {
      proNoteText.innerHTML = `
        <strong>Check with a Professional:</strong> Proper technique, adequate rest, and structured forearm conditioning are essential components of joint comfort.
      `;
    }

    saveState();
  }

  function saveState() {
    try {
      const data = {
        issue: issueSelect.value,
        severity: severitySelect.value,
        weight: weightInput.value,
        unit: activeWeightUnit,
        core: coreSelect.value,
      };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    } catch {}
  }

  function loadState() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const data = JSON.parse(raw);
      if (data.unit && (data.unit === 'oz' || data.unit === 'g')) {
        setWeightUnit(data.unit);
      }
      if (data.issue) issueSelect.value = data.issue;
      if (data.severity) severitySelect.value = data.severity;
      if (data.weight) weightInput.value = data.weight;
      if (data.core) coreSelect.value = data.core;
    } catch {}
  }

  calcBtn.addEventListener('click', calculate);
  loadState();
</script>
