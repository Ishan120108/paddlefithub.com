---
/**
 * About page — brand story, mission, and what makes PaddleFitHub different.
 */
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'About' },
];
---

<Layout
  title="About PaddleFitHub — Free Pickleball Paddle Calculators"
  description="Learn about PaddleFitHub, our mission to help pickleball players find the perfect paddle setup with free, data-driven calculators."
  canonicalPath="/about/"
>
  <div class="bg-canvas-soft">
    <div class="container-narrow py-12 md:py-16">
      <Breadcrumbs items={breadcrumbs} />

      <h1 class="text-display-xl text-ink mb-8">About PaddleFitHub.</h1>

      <div class="space-y-6 text-body-lg text-body">
        <p>
          PaddleFitHub was built out of a simple frustration: finding the right pickleball paddle setup
          should not require guesswork, hours of forum reading, or expensive trial-and-error with multiple paddles.
        </p>

        <p>
          We created a suite of free, data-driven calculators that help players make informed decisions about
          their equipment. Every tool is built on real measurements, established sizing methods, and practical
          playing experience — not marketing copy from paddle manufacturers.
        </p>
      </div>

      <div class="mt-12 pt-8 border-t border-hairline">
        <h2 class="text-display-lg text-ink mb-6">What makes us different.</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="card-soft">
            <h3 class="text-display-sm text-ink mb-2">Real formulas, not opinions.</h3>
            <p class="text-body-sm text-body m-0">
              Our grip size calculator uses the Vernier measurement method — the same technique used by
              professional paddle fitters and tennis pros. Our weight advisor uses play-style matrices
              derived from sports science research. Every formula is documented and transparent.
            </p>
          </div>

          <div class="card-soft">
            <h3 class="text-display-sm text-ink mb-2">No hidden agenda.</h3>
            <p class="text-body-sm text-body m-0">
              We do not sell paddles. We do not take sponsorship money from manufacturers. Our tools
              recommend specifications — not specific products. Your results are never influenced by
              commercial relationships.
            </p>
          </div>

          <div class="card-soft">
            <h3 class="text-display-sm text-ink mb-2">Privacy-first.</h3>
            <p class="text-body-sm text-body m-0">
              No account required. No data sent to servers. Your measurements and preferences stay in
              your browser using localStorage. You own your data, always.
            </p>
          </div>

          <div class="card-soft">
            <h3 class="text-display-sm text-ink mb-2">Always free.</h3>
            <p class="text-body-sm text-body m-0">
              Every calculator on PaddleFitHub is free to use, with no sign-up walls, no premium tiers,
              and no ads. We believe every player deserves access to good equipment guidance.
            </p>
          </div>
        </div>
      </div>

      <div class="mt-12 pt-8 border-t border-hairline">
        <h2 class="text-display-lg text-ink mb-4">Our tools.</h2>
        <p class="text-body-md text-body mb-6">
          We offer seven specialized calculators, each designed to address a specific aspect of paddle selection:
        </p>
        <ul class="space-y-2 text-body-md text-body list-none p-0 m-0">
          <li><a href="/tools/grip-size-calculator/" aria-label="Grip Size Calculator tool page" class="text-link hover:underline">Grip Size Calculator</a> — find your ideal grip using hand measurement</li>
          <li><a href="/tools/paddle-weight-advisor/" aria-label="Paddle Weight Advisor tool page" class="text-link hover:underline">Paddle Weight Advisor</a> — match weight to your play style and arm health</li>
          <li><a href="/tools/paddle-shape-fit/" aria-label="Paddle Shape Fit Calculator tool page" class="text-link hover:underline">Paddle Shape Fit</a> — compare standard, hybrid, and elongated shapes</li>
          <li><a href="/tools/core-thickness-advisor/" aria-label="Core Thickness Advisor tool page" class="text-link hover:underline">Core Thickness Advisor</a> — understand 14 mm, 16 mm, and 20 mm tradeoffs</li>
          <li><a href="/tools/overgrip-weight-adjustment/" aria-label="Overgrip Weight Adjustment tool page" class="text-link hover:underline">Overgrip Weight Adjustment</a> — calculate the effect of adding overgrips</li>
          <li><a href="/tools/arm-friendly-paddle-finder/" aria-label="Arm-Friendly Paddle Finder tool page" class="text-link hover:underline">Arm-Friendly Paddle Finder</a> — prioritize low vibration and strain reduction</li>
          <li><a href="/tools/round-robin-generator/" aria-label="Round-Robin Generator tool page" class="text-link hover:underline">Round-Robin Generator</a> — create fair player rotation schedules</li>
        </ul>
      </div>

      <div class="mt-12 text-center">
        <a href="/tools/grip-size-calculator/" aria-label="Try the Grip Size Calculator" class="btn-primary">
          Try the Grip Size Calculator
        </a>
      </div>
    </div>
  </div>
</Layout>
